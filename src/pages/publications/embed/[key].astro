---
/**
 * A publication summary without the site chrome, for the reader overlay on the
 * publications page. Every paper has one, whether or not its full text is open.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { publications, venueLabel, displayName, isReviewed, pubDateLabel, bucketOf } from "@/lib/pubs";

export async function getStaticPaths() {
  return publications.map((p) => ({ params: { key: p.key }, props: { pub: p } }));
}
const { pub: p } = Astro.props;

const covers = import.meta.glob<{ default: ImageMetadata }>("../../../assets/papers/*.jpg", { eager: true });
const cover = covers[`../../../assets/papers/${p.key}.jpg`]?.default;

const threads = (await getCollection("research")).filter((t) => p.threads?.includes(t.id));
const members = (await getCollection("people")).filter((m) => p.authors.some((a) => a.member === m.id));
const tldr = p.sources?.tldr;
const bucket = bucketOf(p);
const readable = p.arxiv ? `https://arxiv.org/pdf/${p.arxiv}` : null;
const doiUrl = p.doi ? `https://doi.org/${p.doi}` : null;

/** Where a reader can actually get this paper, in the order they should try. */
const venueName = p.venue_info?.name || p.venue_raw || venueLabel(p);
const outLabel =
  bucket === "magazine" ? `Read in ${venueName} ↗` : bucket === "preprint" ? "Open on arXiv ↗" : `Read at ${venueName} ↗`;
const outHref = doiUrl ?? p.url ?? p.venue_info?.url ?? undefined;
---

<Base title={p.title} nav={false} footer={false} noindex>
  <article class="e">
    <div class:list={["e-top", { "e-top--cover": Boolean(cover) }]}>
      {cover && (
        <figure class="e-cover">
          <Image src={cover} alt={`First page of “${p.title}”`} widths={[220, 440]} sizes="220px" loading="eager" />
        </figure>
      )}
      <header class="e-head">
        <p class="e-meta">
          <span class="m e-v">{venueLabel(p)}</span>
          <span class="m e-d">{pubDateLabel(p).toUpperCase()}</span>
          <span class="m e-s">{p.status === "accepted" ? "ACCEPTED — TO APPEAR" : isReviewed(p) ? "PEER-REVIEWED" : bucket === "preprint" ? "PREPRINT" : "MAGAZINE COLUMN"}</span>
        </p>
        <h1 class="e-t">{p.title}</h1>
        <p class="e-a">
          {p.authors.map((a, i) => (
            <>
              {a.member ? (
                <a href={`/people/${a.member}/`} target="_top" class="au-m">{displayName(a.name)}</a>
              ) : (
                <span>{displayName(a.name)}</span>
              )}
              {i < p.authors.length - 1 ? ", " : ""}
            </>
          ))}
        </p>
        <p class="e-vn">
          {venueName}
          {p.volume && `, vol. ${p.volume}`}{p.number && ` (${p.number})`}{p.pages && `, pp. ${p.pages}`}
        </p>

        <div class="e-btns">
          {readable && <button class="btn" type="button" data-read={readable}>Read the PDF</button>}
          {outHref && <a class="btn-o" href={outHref} target="_blank" rel="noopener">{outLabel}</a>}
          <a class="btn-o" href={`/publications/${p.key}/`} target="_top">Full record →</a>
        </div>
      </header>
    </div>

    {tldr && (
      <section class="e-block">
        <p class="m e-lab">SUMMARY — AUTO-GENERATED BY SEMANTIC SCHOLAR</p>
        <p class="e-tldr">{tldr}</p>
      </section>
    )}

    {p.abstract && (
      <section class="e-block">
        <p class="m e-lab">ABSTRACT</p>
        <p class="e-abs">{p.abstract}</p>
      </section>
    )}

    {!p.abstract && !tldr && (
      <section class="e-block">
        <p class="e-none">
          No abstract is published for this item. {outHref ? "Follow the link above to read it at the source." : ""}
        </p>
      </section>
    )}

    <section class="e-block">
      <p class="m e-lab">RECORD</p>
      <dl class="e-facts">
        <div><dt class="m">TYPE</dt><dd>{p.type}{isReviewed(p) ? " · peer-reviewed" : ""}</dd></div>
        {p.doi && <div><dt class="m">DOI</dt><dd><a href={doiUrl} target="_blank" rel="noopener">{p.doi}</a></dd></div>}
        {p.arxiv && <div><dt class="m">ARXIV</dt><dd><a href={`https://arxiv.org/abs/${p.arxiv}`} target="_blank" rel="noopener">{p.arxiv}</a></dd></div>}
        {(p.citations?.count ?? 0) > 0 && <div><dt class="m">CITATIONS</dt><dd>{p.citations!.count}</dd></div>}
        {threads.length > 0 && (
          <div>
            <dt class="m">DIRECTIONS</dt>
            <dd>{threads.map((t, i) => <><a href={`/research/${t.id}/`} target="_top">{t.data.letter} · {t.data.title}</a>{i < threads.length - 1 ? <br /> : ""}</>)}</dd>
          </div>
        )}
        {members.length > 0 && (
          <div>
            <dt class="m">LAB AUTHORS</dt>
            <dd>{members.map((m, i) => <><a href={`/people/${m.id}/`} target="_top">{m.data.name}</a>{i < members.length - 1 ? ", " : ""}</>)}</dd>
          </div>
        )}
      </dl>
    </section>

    <section class="e-block">
      <p class="m e-lab">BIBTEX</p>
      <pre class="e-bib"><code>{p.bibtex}</code></pre>
    </section>
  </article>
</Base>

<style>
  .e { max-width: 820px; margin: 0 auto; padding: clamp(20px, 3vw, 36px) clamp(18px, 3vw, 32px) 44px; }
  .e-top { display: grid; gap: 24px; align-items: start; }
  @media (min-width: 640px) {
    .e-top--cover { grid-template-columns: 200px minmax(0, 1fr); gap: 28px; }
  }
  .e-cover { margin: 0; }
  .e-cover :global(img) { width: 100%; height: auto; border: 1px solid var(--rule); }

  .e-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .e-v { font-size: 7.5px; letter-spacing: .09em; color: #fff; background: var(--ink); padding: 4px 7px; }
  .e-d { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); }
  .e-s { font-size: 7.5px; letter-spacing: .09em; color: var(--brand); border: 1px solid rgba(0,144,81,.34); padding: 3px 6px; }
  .e-t {
    margin-top: 12px; font-variation-settings: "wdth" 112; font-weight: 800;
    font-size: clamp(21px, 2.5vw, 30px); line-height: 1.14; letter-spacing: -0.026em;
  }
  .e-a { margin-top: 10px; font-size: 15px; line-height: 1.5; color: var(--ink-3); }
  .au-m { color: var(--ink); font-weight: 700; border-bottom: 1px solid var(--rule-2); }
  .au-m:hover { color: var(--brand); border-color: var(--brand); }
  .e-vn { margin-top: 6px; font-size: 13.5px; color: var(--ink-4); }
  .e-btns { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 9px; }
  .e-btns .btn, .e-btns .btn-o { height: 38px; padding: 0 15px; font-size: 13.5px; }

  .e-block { margin-top: 26px; padding-top: 16px; border-top: 1px solid var(--rule); }
  .e-lab { font-size: 8px; letter-spacing: .11em; color: var(--ink-5); }
  .e-tldr { margin-top: 9px; padding: 13px 15px; background: var(--bg-tint); border-left: 2px solid var(--brand); font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .e-abs { margin-top: 9px; font-size: 14.5px; line-height: 1.68; color: var(--ink-3); }
  .e-none { margin-top: 9px; font-size: 14.5px; color: var(--ink-4); }

  .e-facts { margin: 9px 0 0; display: grid; }
  .e-facts > div { display: grid; grid-template-columns: 118px minmax(0, 1fr); gap: 14px; padding: 8px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .e-facts dt { font-size: 8px; letter-spacing: .11em; color: var(--ink-5); }
  .e-facts dd { margin: 0; font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .e-facts dd a { border-bottom: 1px solid var(--rule-2); }
  .e-facts dd a:hover { color: var(--brand); border-color: var(--brand); }

  .e-bib { margin: 9px 0 0; padding: 13px 15px; background: var(--bg-soft); border: 1px solid var(--rule); font-family: var(--mono); font-size: 11px; line-height: 1.65; overflow-x: auto; color: var(--ink-2); }
</style>

<script>
  // "Read the PDF" swaps the overlay this page sits in, rather than opening a tab.
  document.querySelectorAll<HTMLElement>("[data-read]").forEach((b) =>
    b.addEventListener("click", () => {
      const url = b.dataset.read!;
      if (window.parent !== window) window.parent.postMessage({ type: "aura:read-pdf", url }, location.origin);
      else window.open(url, "_blank", "noopener");
    })
  );
</script>
