---
/** STUDY 5 — Prospectus. A quiet, printed-document reading: a statement set
 *  large, a numbered contents, and long-form sections with the papers running
 *  down the margin as citations. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { venueLabel, shortName } from "@/lib/pubs";

const dirs = await directions();
---

<Base title="Research — study 5" description="Design study" noindex>
  <div class="page pros">
    <div class="shell">
      <header class="p-head">
        <p class="m p-k">RESEARCH STATEMENT · THE AURA LAB · WILLIAM &amp; MARY</p>
        <h1 class="p-state">{lab.brief[0]}</h1>
        <div class="p-meta">
          <p class="p-body">{lab.statement}</p>
          <ol class="p-toc">
            {dirs.map((d, i) => (
              <li><a href={`#${d.id}`}><span class="m">{String(i + 1).padStart(2, "0")}</span> {d.title} <span class="m p-toc-n">{d.papers.length}</span></a></li>
            ))}
          </ol>
        </div>
      </header>

      {dirs.map((d, i) => (
        <section class="sec" id={d.id} style={`--c:var(--a${i + 1})`}>
          <div class="s-num">
            <span class="m">{String(i + 1).padStart(2, "0")}</span>
            <span class="s-l exp">{d.letter}</span>
          </div>

          <div class="s-main">
            <h2 class="s-t">{d.title}</h2>
            <p class="s-lead">{d.short}</p>
            <blockquote class="s-q">{d.q}</blockquote>
            <p class="s-a">{d.a}</p>
            <p class="s-tags">{d.tags.map((t) => <span>{t}</span>)}</p>
          </div>

          <aside class="s-margin">
            <p class="m s-lab">SELECTED · {d.papers.length} IN THIS DIRECTION</p>
            <ol class="s-cites">
              {d.papers.slice(0, 4).map((p) => (
                <li>
                  <a href={`/publications/${p.key}/`}>
                    <span class="c-a">{p.authors.map((a) => shortName(a.name)).slice(0, 3).join(", ")}{p.authors.length > 3 ? " et al." : ""}</span>
                    <span class="c-t">{p.title}</span>
                    <span class="m c-v">{venueLabel(p)} · {p.year}</span>
                  </a>
                </li>
              ))}
            </ol>
            <a class="s-go" href={`/research/${d.id}/`}>Full direction →</a>
          </aside>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .p-head { padding-bottom: clamp(30px, 3.4vw, 48px); border-bottom: 1.5px solid var(--rule-3); }
  .p-k { font-size: 8px; letter-spacing: .14em; color: var(--brand); }
  .p-state {
    margin-top: 18px; max-width: 21ch; font-size: clamp(30px, 4.6vw, 62px); font-weight: 300;
    line-height: 1.06; letter-spacing: -0.036em; color: var(--ink);
  }
  .p-meta { display: grid; gap: 28px; margin-top: clamp(24px, 2.8vw, 40px); }
  @media (min-width: 900px) { .p-meta { grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: start; } }
  .p-body { font-size: 15px; line-height: 1.7; color: var(--ink-3); max-width: 62ch; }
  .p-toc { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .p-toc a { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid var(--rule); font-size: 14px; font-weight: 600; }
  .p-toc a:hover { color: var(--brand); }
  .p-toc .m { font-size: 8px; color: var(--ink-5); }
  .p-toc-n { font-size: 8px; color: var(--ink-5); }

  .sec { display: grid; gap: 22px; padding: clamp(34px, 4vw, 58px) 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 1000px) { .sec { grid-template-columns: 62px minmax(0, 1.35fr) minmax(230px, .85fr); gap: 40px; } }
  .s-num { display: flex; align-items: baseline; gap: 10px; }
  @media (min-width: 1000px) { .s-num { display: block; } }
  .s-num .m { font-size: 8px; letter-spacing: .1em; color: var(--ink-5); }
  .s-l { display: block; margin-top: 6px; font-size: 34px; font-weight: 300; line-height: .9; color: var(--c); font-variation-settings: "wdth" 112; }

  .s-t { font-size: clamp(22px, 2.4vw, 32px); font-weight: 300; letter-spacing: -0.03em; line-height: 1.14; max-width: 22ch; }
  .s-lead { margin-top: 14px; font-size: 15.5px; line-height: 1.7; color: var(--ink-3); max-width: 62ch; }
  .s-q {
    margin: 22px 0 0; padding: 0 0 0 18px; border-left: 2px solid var(--c);
    font-size: clamp(17px, 1.8vw, 22px); font-weight: 300; line-height: 1.36; letter-spacing: -0.02em; color: var(--ink);
  }
  .s-a { margin-top: 14px; font-size: 14.5px; line-height: 1.7; color: var(--ink-3); max-width: 62ch; }
  .s-tags { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .s-tags span { font-family: var(--mono); font-size: 8px; letter-spacing: .09em; color: var(--ink-5); }
  .s-tags span + span::before { content: "·"; margin-right: 12px; color: var(--rule-2); }

  .s-lab { font-size: 8px; letter-spacing: .1em; color: var(--ink-5); }
  .s-cites { list-style: none; margin: 12px 0 0; padding: 0; }
  .s-cites li { padding: 11px 0; border-top: 1px solid var(--rule); }
  .s-cites a { display: block; }
  .c-a { display: block; font-size: 11.5px; color: var(--ink-5); }
  .c-t { display: block; margin-top: 3px; font-size: 13px; line-height: 1.42; color: var(--ink-2); }
  .s-cites a:hover .c-t { color: var(--c); }
  .c-v { display: block; margin-top: 4px; font-size: 7.5px; letter-spacing: .09em; color: var(--ink-5); }
  .s-go { display: inline-block; margin-top: 14px; font-size: 12.5px; font-weight: 700; }
  .s-go:hover { color: var(--c); }
</style>
