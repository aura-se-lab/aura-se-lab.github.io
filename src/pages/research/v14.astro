---
/** STUDY 14 — Cutout. Four full-bleed quadrants. The title is not set over
 *  the motif, it is cut out of the panel so the motif shows through the
 *  letterforms. The quadrant under the cursor takes the room from the others. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { venueLabel } from "@/lib/pubs";

const dirs = await directions();
const motif = ["quantize", "parse", "measure", "flow"];
/** The title, split so the cut-out reads as a stack rather than a paragraph. */
const stack = (t: string) => {
  const w = t.split(" ");
  const out: string[] = [];
  let line = "";
  for (const x of w) {
    if ((line + " " + x).trim().length > 16 && line) { out.push(line); line = x; }
    else line = (line + " " + x).trim();
  }
  if (line) out.push(line);
  return out;
};
---

<Base title="Research — study 14" description="Design study" noindex>
  <section class="intro">
    <div class="shell">
      <p class="label">FOUR AVENUES</p>
      <h1 class="in-h">Research</h1>
      <p class="in-l">{lab.brief[0]}</p>
      <p class="m in-c">Hover a quadrant to open it</p>
    </div>
  </section>

  <div class="quads" id="quads">
    {dirs.map((d, i) => (
      <article class="qd" style={`--c:var(--a${i + 1})`} data-i={String(i)}>
        <canvas class="q-cv" data-motif={motif[i]} aria-hidden="true"></canvas>
        <svg class="q-cut" viewBox="0 0 600 380" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <defs>
            <mask id={`cut${i}`} maskUnits="userSpaceOnUse" x="-900" y="-600" width="2400" height="1600">
              <rect x="-900" y="-600" width="2400" height="1600" fill="#fff" />
              {/* Every line is set to the same measure, so the knockout reads
                  as a justified block instead of a ragged one that slices off
                  the panel edge. */}
              {stack(d.title).map((l, j, all) => (
                <text
                  x="30"
                  y={158 - (all.length - 1) * 34 + j * 68}
                  textLength="540"
                  lengthAdjust="spacingAndGlyphs"
                  fill="#000"
                >{l}</text>
              ))}
            </mask>
          </defs>
          <rect x="-900" y="-600" width="2400" height="1600" fill="var(--bg)" mask={`url(#cut${i})`} />
        </svg>
        <div class="q-in">
          <p class="m q-n">{String(i + 1).padStart(2, "0")} · {d.papers.length} PAPERS · {d.span}</p>
          <h2 class="q-sr">{d.title}</h2>
          <p class="q-q">{d.q}</p>
          <div class="q-fold">
            <p class="q-a">{d.a}</p>
            <ul class="q-work">
              {d.papers.slice(0, 3).map((p) => (
                <li><a href={`/publications/${p.key}/`}><span class="m">{venueLabel(p)} {p.year}</span>{p.title}</a></li>
              ))}
            </ul>
            <a class="q-go" href={`/research/${d.id}/`}>Open the direction →</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .intro { padding: clamp(34px, 4.6vw, 72px) 0 clamp(26px, 3vw, 42px); }
  .in-h { margin-top: 10px; font-size: clamp(34px, 5vw, 64px); font-weight: 800; line-height: 1; letter-spacing: -0.04em; font-variation-settings: "wdth" 112; }
  .in-l { margin-top: 14px; max-width: 62ch; font-size: 15.5px; line-height: 1.68; color: var(--ink-3); }
  .in-c { margin-top: 16px; font-size: 8px; letter-spacing: .12em; color: var(--ink-5); }

  .quads { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--rule-3); border-block: 1px solid var(--rule-3); }
  @media (min-width: 900px) {
    .quads { grid-template-columns: 1fr 1fr; grid-auto-rows: minmax(0, 1fr); height: 86vh; min-height: 620px; }
    /* The quadrant under the cursor takes room from its neighbour rather than
       growing the page. */
    .quads:has(.qd[data-i="0"]:hover), .quads:has(.qd[data-i="2"]:hover) { grid-template-columns: 1.42fr 0.58fr; }
    .quads:has(.qd[data-i="1"]:hover), .quads:has(.qd[data-i="3"]:hover) { grid-template-columns: 0.58fr 1.42fr; }
    .quads { transition: grid-template-columns .55s cubic-bezier(.2,.8,.25,1); }
  }

  .qd { position: relative; overflow: hidden; background: var(--bg); min-height: 300px; }
  .q-cv { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 1; background: color-mix(in srgb, var(--c) 13%, var(--bg)); }

  /* The panel is painted over the motif and the title is punched out of it. */
  .q-cut { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .45s ease; }
  .q-cut text {
    font-family: var(--font-sans); font-weight: 800; font-size: 54px;
    letter-spacing: -2.2px; font-variation-settings: "wdth" 116;
  }
  .qd:hover .q-cut { opacity: .1; }

  .q-in {
    position: absolute; inset: auto 0 0 0; z-index: 2; padding: clamp(18px, 2.4vw, 40px);
    background: linear-gradient(to top, var(--bg) 62%, rgba(255,255,255,.86) 88%, transparent);
  }
  .q-n { font-size: 8px; letter-spacing: .11em; color: var(--c); }
  /* The cut-out carries the title visually; this one carries it to a reader. */
  .q-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .q-q { margin-top: 10px; max-width: 30ch; font-size: clamp(15px, 1.35vw, 20px); font-weight: 300; line-height: 1.24; letter-spacing: -0.022em; }

  .q-fold { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .5s cubic-bezier(.2,.8,.25,1), opacity .32s ease; }
  .qd:hover .q-fold, .qd:focus-within .q-fold { max-height: 340px; opacity: 1; }
  .q-a { margin-top: 12px; max-width: 58ch; font-size: 13.5px; line-height: 1.6; color: var(--ink-3); }
  .q-work { list-style: none; margin: 13px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .q-work a { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 10px; align-items: baseline; padding: 7px 0; border-bottom: 1px solid var(--rule); font-size: 12.5px; font-weight: 600; }
  .q-work .m { font-size: 7.5px; letter-spacing: .09em; color: var(--ink-5); }
  .q-work a:hover { color: var(--c); }
  .q-go { display: inline-block; margin-top: 12px; font-size: 12.5px; font-weight: 700; color: var(--c); }

  @media (prefers-reduced-motion: reduce) { .quads { transition: none; } }
</style>

<script>
  import { mountMotif, type Motif } from "@/scripts/motifs";
  const cs = getComputedStyle(document.documentElement);
  document.querySelectorAll<HTMLElement>(".qd").forEach((qd, i) => {
    const c = cs.getPropertyValue(`--a${i + 1}`).trim() || "#009051";
    const cv = qd.querySelector("canvas") as HTMLCanvasElement;
    const ctl = mountMotif(cv, cv.dataset.motif as Motif, c);
    ctl.energy(0.85);
    qd.addEventListener("mouseenter", () => ctl.energy(1));
    qd.addEventListener("mouseleave", () => ctl.energy(0.5));
  });
</script>
