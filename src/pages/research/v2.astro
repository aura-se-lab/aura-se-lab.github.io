---
/** STUDY 2 — The A·U·R·A spine. A sticky letter rail down the left; each
 *  direction is a chapter, with the findings as a ledger rather than tags. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { venueLabel } from "@/lib/pubs";

const dirs = await directions();
---

<Base title="Research — study 2" description="Design study" noindex>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <div class="row">
          <div>
            <p class="label">A · U · R · A</p>
            <h1 class="h2 mt-2">Research</h1>
          </div>
        </div>
        <p class="lead" style="max-width:62ch">{lab.brief[0]}</p>
      </header>

      <div class="spine">
        <nav class="rail" aria-label="Directions">
          {dirs.map((d, i) => (
            <a href={`#${d.id}`} style={`--c:var(--a${i + 1})`}>
              <span class="r-l exp">{d.letter}</span>
              <span class="r-t">{d.title.split(/[&—]/)[0].trim()}</span>
              <span class="m r-n">{d.papers.length}</span>
            </a>
          ))}
        </nav>

        <div class="chapters">
          {dirs.map((d, i) => (
            <section class="ch" id={d.id} style={`--c:var(--a${i + 1})`}>
              <p class="m ch-n">{String(i + 1).padStart(2, "0")} — {d.span} — {d.papers.length} PAPERS</p>
              <h2 class="ch-t">{d.title}</h2>
              <p class="ch-lead">{d.short}</p>

              <div class="ch-grid">
                <div>
                  <p class="m ch-lab">WHAT WE ARE ASKING</p>
                  <p class="ch-q">{d.q}</p>
                  <p class="m ch-lab mt">WHERE IT STANDS</p>
                  <p class="ch-a">{d.a}</p>
                </div>
                <div>
                  <p class="m ch-lab">RECENT WORK</p>
                  <ul class="led">
                    {d.papers.slice(0, 4).map((p) => (
                      <li>
                        <a href={`/publications/${p.key}/`}>
                          <span class="m led-v">{venueLabel(p)}</span>
                          <span class="led-t">{p.title}</span>
                          <span class="m led-y">{p.year}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <p class="ch-tags">{d.tags.map((t) => <span class="tg">{t}</span>)}</p>
                  <a class="ch-go" href={`/research/${d.id}/`}>Open the direction →</a>
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .spine { display: grid; gap: 34px; }
  @media (min-width: 1000px) { .spine { grid-template-columns: 232px minmax(0, 1fr); gap: 56px; align-items: start; } }

  .rail { display: none; }
  @media (min-width: 1000px) {
    .rail { display: grid; gap: 2px; position: sticky; top: calc(var(--nav-h) + 26px); }
  }
  .rail a { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; align-items: baseline; gap: 10px; padding: 11px 12px 11px 8px; border-left: 2px solid var(--rule); }
  .rail a:hover { background: var(--bg-soft); border-color: var(--c); }
  .r-l { font-size: 17px; font-weight: 800; color: var(--c); font-variation-settings: "wdth" 118; }
  .r-t { font-size: 13px; font-weight: 600; color: var(--ink-3); line-height: 1.3; }
  .rail a:hover .r-t { color: var(--ink); }
  .r-n { font-size: 8px; color: var(--ink-5); }

  .ch { padding: 0 0 clamp(38px, 4.5vw, 64px); }
  .ch + .ch { padding-top: clamp(34px, 4vw, 54px); border-top: 1px solid var(--rule); }
  .ch-n { font-size: 8px; letter-spacing: .12em; color: var(--c); }
  .ch-t { margin-top: 9px; font-size: clamp(24px, 2.6vw, 36px); font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; max-width: 20ch; }
  .ch-lead { margin-top: 12px; max-width: 70ch; font-size: 16px; line-height: 1.62; color: var(--ink-3); }
  .ch-grid { display: grid; gap: 28px; margin-top: 26px; }
  @media (min-width: 860px) { .ch-grid { grid-template-columns: 1.05fr 1fr; gap: 44px; } }
  .ch-lab { font-size: 8px; letter-spacing: .12em; color: var(--ink-5); }
  .ch-lab.mt { margin-top: 22px; }
  .ch-q { margin-top: 8px; font-size: clamp(17px, 1.7vw, 21px); font-weight: 700; line-height: 1.34; letter-spacing: -0.018em; border-left: 2px solid var(--c); padding-left: 14px; }
  .ch-a { margin-top: 8px; font-size: 14.5px; line-height: 1.65; color: var(--ink-3); }

  .led { list-style: none; margin: 9px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .led a { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .led a:hover .led-t { color: var(--c); }
  .led-v { font-size: 7.5px; letter-spacing: .09em; color: #fff; background: var(--ink); padding: 3px 0; text-align: center; }
  .led-t { font-size: 13.5px; font-weight: 600; line-height: 1.35; }
  .led-y { font-size: 8px; color: var(--ink-5); }
  .ch-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 14px; }
  .tg { font-family: var(--mono); font-size: 8px; letter-spacing: .07em; color: var(--ink-4); border: 1px solid var(--rule-2); padding: 4px 7px; }
  .ch-go { display: inline-block; margin-top: 16px; font-size: 13.5px; font-weight: 700; border-bottom: 1px solid var(--rule-2); }
  .ch-go:hover { color: var(--c); border-color: var(--c); }
</style>
