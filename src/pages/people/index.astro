---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import SectionHead from "@/components/SectionHead.astro";
import PersonCard from "@/components/PersonCard.astro";
import { lab, collaborators } from "@/lib/lab";
import { pubsByMember } from "@/lib/pubs";
import { ArrowUpRight, Globe, Mail, GraduationCap, Code, Briefcase } from "@lucide/astro";

const all = (await getCollection("people")).sort((a, b) => a.data.order - b.data.order);
const director = all.find((p) => p.data.role === "director")!;
const { Content: DirectorBio } = await render(director);
const current = all.filter((p) => p.data.status === "current" && p.data.role !== "director");
const phd = current.filter((p) => p.data.role === "phd");
const msc = current.filter((p) => p.data.role === "msc" || p.data.role === "postdoc" || p.data.role === "visitor");
const ug = current.filter((p) => p.data.role === "undergrad");
const alumni = all.filter((p) => p.data.status === "alumni");
const numberWord = (n: number) => ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten"][n] ?? String(n);
const d = director.data;
---

<Base title="People" description={`The people of the AURA Lab at William & Mary: director ${d.name}, ${phd.length} Ph.D. students, ${ug.length} undergraduate researchers, alumni and collaborators.`} image="/og/people.png">
  <section class="page-hero">
    <div class="shell">
      <p class="caption"><span class="caption-num">People</span> · {lab.short_name}</p>
      <h1 class="h1 mt-2">Lab <b>members</b>.</h1>
      <p class="lead mt-3" style="max-width:66ch">A growing group of Ph.D. students and undergraduates working at the intersection of AI and software engineering — advised by {d.name} at William & Mary.</p>
    </div>
  </section>

  <section class="section section--flush">
    <div class="shell">
      <article class="director">
        <div class="dir-photo">
          {d.photo && <Image src={d.photo} alt={d.name} width={720} height={720} class="avatar" />}
          <div class="caption mt-2">ID / DIR-00</div>
        </div>
        <div>
          <p class="caption">// Personnel record · Lab director</p>
          <h2 class="h2 mt-1"><a href={`/people/${director.id}/`}>{d.name}</a></h2>
          <p class="dir-role mt-1">{d.title}</p>
          <div class="prose mt-3 dir-bio"><DirectorBio /></div>
          <div class="dir-links mt-3">
            {d.links.website && <a href={d.links.website} target="_blank" rel="noopener"><Globe />Website</a>}
            {d.email && <a href={`mailto:${d.email}`}><Mail />Email</a>}
            {d.links.scholar && <a href={d.links.scholar} target="_blank" rel="noopener"><GraduationCap />Scholar</a>}
            {d.links.github && <a href={d.links.github} target="_blank" rel="noopener"><Code />GitHub</a>}
            {d.links.linkedin && <a href={d.links.linkedin} target="_blank" rel="noopener"><Briefcase />LinkedIn</a>}
            <a href={`/people/${director.id}/`} class="link-arrow">{pubsByMember(director.id).length} publications <ArrowUpRight /></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section" id="phd">
    <div class="shell">
      <div class="divider">
        <span class="caption"><span class="caption-num">01</span> · Ph.D. students</span>
        <h2 class="h3">Doctoral researchers</h2>
        <span class="caption">N = {numberWord(phd.length)}</span>
      </div>
      <div class="grid-4 mt-3">{phd.map((p, i) => <PersonCard person={p} idx={`ID / PHD-${String(i + 1).padStart(2, "0")}`} />)}</div>
    </div>
  </section>

  {msc.length > 0 && (
    <section class="section" id="others">
      <div class="shell">
        <div class="divider">
          <span class="caption"><span class="caption-num">02</span> · Researchers & visitors</span>
          <h2 class="h3">Postdocs, M.Sc. students & visitors</h2>
          <span class="caption">N = {numberWord(msc.length)}</span>
        </div>
        <div class="grid-4 mt-3">{msc.map((p, i) => <PersonCard person={p} idx={`ID / ${p.data.role.toUpperCase()}-${String(i + 1).padStart(2, "0")}`} />)}</div>
      </div>
    </section>
  )}

  <section class="section" id="undergrad">
    <div class="shell">
      <div class="divider">
        <span class="caption"><span class="caption-num">{msc.length ? "03" : "02"}</span> · Undergraduates</span>
        <h2 class="h3">Undergraduate researchers</h2>
        <span class="caption">N = {numberWord(ug.length)}</span>
      </div>
      <div class="grid-4 mt-3">{ug.map((p, i) => <PersonCard person={p} idx={`ID / UG-${String(i + 1).padStart(2, "0")}`} />)}</div>
    </div>
  </section>

  {alumni.length > 0 && (
    <section class="section" id="alumni">
      <div class="shell">
        <div class="divider">
          <span class="caption"><span class="caption-num">{msc.length ? "04" : "03"}</span> · Alumni</span>
          <h2 class="h3">Alumni</h2>
          <span class="caption">N = {numberWord(alumni.length)}</span>
        </div>
        <ul class="alumni mt-3">
          {alumni.map((p) => (
            <li>
              <a href={`/people/${p.id}/`} class="al-name">{p.data.name}</a>
              <span class="al-role">{p.data.title ?? p.data.role}</span>
              <span class="al-when mono">{p.data.joined?.slice(0, 4)}{p.data.left ? `–${p.data.left.slice(0, 4)}` : ""}</span>
              {p.data.next && <span class="al-next">→ {p.data.next}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" id="collaborators">
    <div class="shell">
      <div class="divider">
        <span class="caption"><span class="caption-num">{msc.length ? "05" : "04"}</span> · Collaborators</span>
        <h2 class="h3">Frequent collaborators</h2>
        <span class="caption">N = {numberWord(collaborators.length)}</span>
      </div>
      <ul class="collab mt-3">
        {collaborators.map((c) => (
          <li>
            {c.url ? <a href={c.url} target="_blank" rel="noopener" class="cb-name">{c.name} <ArrowUpRight /></a> : <span class="cb-name">{c.name}</span>}
            <span class="cb-aff">{c.affiliation}</span>
            {c.note && <span class="cb-note mono">// {c.note}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .director { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 800px) { .director { grid-template-columns: 260px 1fr; gap: 48px; } }
  .dir-photo :global(.avatar) { border-radius: 10px; }
  .dir-role { font-size: 15px; color: var(--ink-mute); }
  .dir-bio { font-size: 16px; }
  .dir-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13.5px; align-items: center; }
  .dir-links a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-mute); }
  .dir-links a:hover { color: var(--accent); }
  .dir-links :global(svg) { width: 14px; height: 14px; }
  .divider { display: grid; grid-template-columns: 1fr auto; gap: 6px 24px; align-items: baseline; padding-bottom: 12px; border-bottom: var(--hair) solid var(--line); }
  .divider .h3 { grid-column: 1; }
  .divider .caption:last-child { grid-column: 2; grid-row: 1 / span 2; align-self: end; }
  .alumni li, .collab li { display: grid; grid-template-columns: 1fr; gap: 2px 20px; padding: 12px 0; border-bottom: var(--hair) solid var(--line-soft); font-size: 14.5px; }
  @media (min-width: 720px) { .alumni li { grid-template-columns: 240px 1fr 90px 1fr; align-items: baseline; } .collab li { grid-template-columns: 260px 1fr 1fr; align-items: baseline; } }
  .al-name, .cb-name { font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
  .cb-name :global(svg) { width: 12px; height: 12px; color: var(--ink-faint); }
  .al-role, .cb-aff { color: var(--ink-mute); }
  .al-when { font-size: 11.5px; color: var(--ink-faint); letter-spacing: 0.04em; }
  .al-next, .cb-note { color: var(--ink-faint); font-size: 12.5px; }
</style>
