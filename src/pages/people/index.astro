---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { lab, collaborators } from "@/lib/lab";
import { pubsByMember } from "@/lib/pubs";

const all = (await getCollection("people")).sort((a, b) => a.data.order - b.data.order);
const director = all.find((p) => p.data.role === "director")!;
const { Content: Bio } = await render(director);
const current = all.filter((p) => p.data.status === "current" && p.data.role !== "director");
const alumni = all.filter((p) => p.data.status === "alumni");

const groups = [
  { k: "Doctoral researchers", list: current.filter((p) => p.data.role === "phd") },
  { k: "Postdocs, master's and visitors", list: current.filter((p) => ["postdoc", "msc", "visitor"].includes(p.data.role)) },
  { k: "Undergraduate researchers", list: current.filter((p) => p.data.role === "undergrad") },
].filter((g) => g.list.length);

const linkLabels: Record<string, string> = {
  website: "SITE",
  scholar: "SCHOLAR",
  github: "GITHUB",
  linkedin: "LINKEDIN",
  x: "X",
  bluesky: "BLUESKY",
  orcid: "ORCID",
  dblp: "DBLP",
};
const d = director.data;
---

<Base
  title="People"
  description={`The people of the AURA Lab at William & Mary — ${d.name} and ${current.length} researchers.`}
  image="/og/people.png"
>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <div class="row">
          <div>
            <p class="label">PEOPLE</p>
            <h1 class="h2" style="margin-top:8px">People</h1>
          </div>
          <p class="head-n m">{current.length + 1} CURRENT · {alumni.length} ALUMNI · {collaborators.length} COLLABORATORS</p>
        </div>
        <p class="lead">
          Doctoral and undergraduate researchers working on the efficiency, interpretability and honest evaluation of
          AI for software engineering — advised by {d.name} in the {lab.institution.department} at {lab.institution.name}.
        </p>
      </header>

      <!-- ── director ─────────────────────────────────────────────────── -->
      <article class="dir">
        <div class="dir-shot">
          {d.photo && (
            <Image src={d.photo} alt={d.name} widths={[380, 760]} sizes="(max-width: 900px) 90vw, 380px" loading="eager" />
          )}
        </div>
        <div class="dir-body">
          <p class="label">LAB DIRECTOR</p>
          <h2 class="h2 dir-name">{d.name}</h2>
          <p class="dir-role">{d.title} · {lab.institution.department}, {lab.institution.name}</p>
          <div class="prose dir-bio"><Bio /></div>
          <div class="tag-row" style="margin-top:18px">
            {d.interests.map((i) => <span class="tag">{i}</span>)}
          </div>
          <div class="btn-row" style="margin-top:20px">
            <a class="btn" href={`/people/${director.id}/`}>Profile</a>
            {d.links.website && <a class="btn-o" href={d.links.website} target="_blank" rel="noopener">Personal site ↗</a>}
            {d.email && <a class="btn-o" href={`mailto:${d.email}`}>Email</a>}
          </div>
        </div>
      </article>

      <!-- ── members ──────────────────────────────────────────────────── -->
      {groups.map((g) => (
        <section class="grp">
          <div class="grp-head">
            <h2 class="h3">{g.k}</h2>
            <span class="m grp-n">{g.list.length}</span>
          </div>
          <ul class="people">
            {g.list.map((p) => {
              const shot = p.data.photo;
              const np = pubsByMember(p.id).length;
              return (
                <li class="pc">
                  <a class="pc-shot" href={`/people/${p.id}/`}>
                    {shot ? (
                      <Image src={shot} alt={p.data.name} widths={[240, 480]} sizes="(max-width: 700px) 45vw, 240px" loading="lazy" />
                    ) : (
                      <span class="pc-blank exp">{p.data.name.split(" ").map((w) => w[0]).slice(0, 2).join("")}</span>
                    )}
                  </a>
                  <div class="pc-b">
                    <h3 class="pc-n"><a href={`/people/${p.id}/`}>{p.data.name}</a></h3>
                    <p class="pc-r">{p.data.title ?? p.data.role}</p>
                    {p.data.interests.length > 0 && <p class="pc-i">{p.data.interests.slice(0, 3).join(" · ")}</p>}
                    <p class="pc-l">
                      {np > 0 && <a class="tg tg-a" href={`/publications/?member=${p.id}&kind=all`}>{np} PAPERS</a>}
                      {Object.entries(p.data.links)
                        .filter(([, v]) => v)
                        .slice(0, 3)
                        .map(([k, v]) => (
                          <a class="tg" href={v as string} target="_blank" rel="noopener">{linkLabels[k] ?? k.toUpperCase()}</a>
                        ))}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      {alumni.length > 0 && (
        <section class="grp">
          <div class="grp-head"><h2 class="h3">Alumni</h2><span class="m grp-n">{alumni.length}</span></div>
          <ul class="rows">
            {alumni.map((p) => (
              <li class="rw">
                <a class="rw-n" href={`/people/${p.id}/`}>{p.data.name}</a>
                <span class="rw-m">{p.data.title ?? p.data.role}{p.data.next ? ` — now at ${p.data.next}` : ""}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {collaborators.length > 0 && (
        <section class="grp">
          <div class="grp-head">
            <h2 class="h3">External collaborators</h2>
            <span class="m grp-n">{collaborators.length}</span>
          </div>
          <ul class="rows">
            {collaborators.map((c) => (
              <li class="rw">
                {c.url ? (
                  <a class="rw-n" href={c.url} target="_blank" rel="noopener">{c.name} ↗</a>
                ) : (
                  <span class="rw-n">{c.name}</span>
                )}
                <span class="rw-m">{c.affiliation}{c.note ? ` · ${c.note}` : ""}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .head-n { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); }

  /* ── director ──────────────────────────────────────────────────────────── */
  .dir { display: grid; gap: clamp(22px, 3vw, 46px); align-items: start; }
  @media (min-width: 900px) { .dir { grid-template-columns: minmax(240px, 340px) minmax(0, 1fr); } }
  .dir-shot { border: 1px solid var(--rule); background: var(--bg-soft); }
  .dir-shot :global(img) { width: 100%; height: auto; aspect-ratio: 56 / 73; object-fit: cover; }
  .dir-name { font-size: clamp(26px, 2.6vw, 38px); margin-top: 8px; }
  .dir-role { margin-top: 6px; font-size: 14.5px; color: var(--ink-3); }
  .dir-bio { margin-top: 16px; font-size: 15px; }

  /* ── groups ────────────────────────────────────────────────────────────── */
  .grp { margin-top: clamp(38px, 4.4vw, 64px); }
  .grp-head { display: flex; align-items: baseline; gap: 12px; padding-bottom: 12px; border-bottom: 1.5px solid var(--rule-3); }
  .grp-n { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); margin-left: auto; }

  .people { margin-top: 22px; display: grid; gap: 26px 22px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .pc { display: grid; gap: 12px; }
  .pc-shot { display: block; border: 1px solid var(--rule); background: var(--bg-soft); overflow: hidden; transition: border-color .24s ease, transform .24s cubic-bezier(.2,.8,.25,1); }
  .pc-shot :global(img) { width: 100%; height: auto; aspect-ratio: 56 / 73; object-fit: cover; transition: transform .5s cubic-bezier(.2,.8,.25,1); }
  .pc:hover .pc-shot { border-color: var(--rule-3); transform: translateY(-3px); }
  .pc:hover .pc-shot :global(img) { transform: scale(1.035); }
  .pc-blank { display: grid; place-items: center; aspect-ratio: 56 / 73; font-size: 36px; font-weight: 800; color: var(--ink-5); }
  .pc-n { font-size: 15px; font-weight: 700; letter-spacing: -0.014em; font-variation-settings: "wdth" 106; }
  .pc-n a:hover { color: var(--brand); }
  .pc-r { margin-top: 3px; font-size: 12.5px; color: var(--ink-3); }
  .pc-i { margin-top: 5px; font-size: 12px; color: var(--ink-5); line-height: 1.4; }
  .pc-l { margin-top: 9px; display: flex; flex-wrap: wrap; gap: 5px; }

  /* ── rows ──────────────────────────────────────────────────────────────── */
  .rows { margin-top: 6px; }
  .rw { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .rw-n { font-size: 15px; font-weight: 600; }
  a.rw-n:hover { color: var(--brand); }
  .rw-m { font-size: 13px; color: var(--ink-4); }
</style>
