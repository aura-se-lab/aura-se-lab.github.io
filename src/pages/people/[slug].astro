---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import PubList from "@/components/PubList.astro";
import { pubsByMember, isReviewed } from "@/lib/pubs";
import { fmtYm, fmtDate } from "@/lib/dates";
import { lab } from "@/lib/lab";
import { ArrowLeft, Globe, Mail, GraduationCap, Code, Briefcase, AtSign, ExternalLink, Award } from "@lucide/astro";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((p) => ({ params: { slug: p.id }, props: { person: p } }));
}
const { person } = Astro.props;
const { Content } = await render(person);
const d = person.data;
const pubs = pubsByMember(person.id);
const threads = (await getCollection("research")).filter((t) => d.threads.includes(t.id)).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection("news", ({ data }) => !data.draft && data.people.includes(person.id))).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const site = (Astro.site ?? new URL("https://auralab.sh")).origin;
const linkIcons: Record<string, any> = { website: Globe, scholar: GraduationCap, github: Code, linkedin: Briefcase, x: AtSign, bluesky: ExternalLink, orcid: ExternalLink, dblp: ExternalLink };
const linkLabels: Record<string, string> = { website: "Website", scholar: "Google Scholar", github: "GitHub", linkedin: "LinkedIn", x: "X", bluesky: "Bluesky", orcid: "ORCID", dblp: "DBLP" };
const roleLabel: Record<string, string> = { director: "Lab Director", phd: "Ph.D. Student", msc: "M.Sc. Student", undergrad: "Undergraduate Researcher", postdoc: "Postdoctoral Researcher", visitor: "Visiting Researcher", alumni: "Alumni", collaborator: "Collaborator" };
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site}/people/${person.id}/#person`,
  name: d.name.replace(/\s*\([^)]*\)/, ""),
  jobTitle: d.title ?? roleLabel[d.role],
  affiliation: { "@id": `${site}/#org` },
  worksFor: { "@id": `${site}/#org` },
  url: `${site}/people/${person.id}/`,
  ...(d.email ? { email: d.email } : {}),
  sameAs: Object.values(d.links).filter(Boolean),
  knowsAbout: d.interests,
};
const desc = `${d.name} — ${d.title ?? roleLabel[d.role]} at the AURA Lab, William & Mary. ${d.interests.join(", ")}.`;
---

<Base title={d.name} description={desc} image={`/og/people-${person.id}.png`} type="profile" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="shell person-hero">
      <div class="ph-photo">
        {d.photo ? <Image src={d.photo} alt={d.name} width={640} height={640} class="avatar" /> : <div class="avatar-placeholder">{d.name.split(" ").map((s) => s[0]).slice(0, 2).join("")}</div>}
      </div>
      <div>
        <p class="caption"><a href="/people/">People</a> · <span class="caption-num">{roleLabel[d.role] ?? d.role}</span>{d.status === "alumni" && " · alumni"}</p>
        <h1 class="h1 mt-2" style="font-size:clamp(34px,4.4vw,60px)">{d.name}</h1>
        <p class="lead mt-2">{d.title ?? roleLabel[d.role]}{d.role !== "director" && ` · ${lab.short_name}, ${lab.institution.name}`}</p>
        {d.interests.length > 0 && <div class="tag-row mt-3">{d.interests.map((i) => <span class="tag tag--accent">{i}</span>)}</div>}
        <div class="ph-links mt-3">
          {d.email && <a href={`mailto:${d.email}`}><Mail />{d.email}</a>}
          {Object.entries(d.links).map(([k, v]) => {
            if (!v) return null;
            const I = linkIcons[k] ?? ExternalLink;
            return (
              <a href={v} target="_blank" rel="noopener">
                <I />
                {linkLabels[k] ?? k}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="shell person-grid">
      <div class="prose">
        <Content />
      </div>
      <aside>
        <dl class="essentials">
          {d.joined && <div class="es-row"><dt class="es-k">Joined</dt><dd class="es-v">{fmtYm(d.joined)}</dd></div>}
          {d.left && <div class="es-row"><dt class="es-k">Left</dt><dd class="es-v">{fmtYm(d.left)}{d.next && ` → ${d.next}`}</dd></div>}
          {d.coadvised && <div class="es-row"><dt class="es-k">Co-advised</dt><dd class="es-v">with {d.coadvised}</dd></div>}
          {threads.length > 0 && <div class="es-row"><dt class="es-k">Threads</dt><dd class="es-v">{threads.map((t, i) => <><a href={`/research/${t.id}/`}>{t.data.letter} · {t.data.title}</a>{i < threads.length - 1 ? <br /> : ""}</>)}</dd></div>}
          {pubs.length > 0 && <div class="es-row"><dt class="es-k">Papers</dt><dd class="es-v"><b>{pubs.length}</b> with the lab <span class="es-faint">· {pubs.filter(isReviewed).length} peer-reviewed</span></dd></div>}
        </dl>
        {d.awards.length > 0 && (
          <>
            <p class="caption mt-4">// Awards & honors</p>
            <ul class="mt-2 awards">
              {d.awards.map((a) => (
                <li><Award />{a.title}{a.year && <span class="faint"> · {a.year}</span>}</li>
              ))}
            </ul>
          </>
        )}
        {news.length > 0 && (
          <>
            <p class="caption mt-4">// In the news</p>
            <ul class="mt-2">
              {news.map((n) => (
                <li class="news-mini"><a href={`/news/${n.id}/`}>{n.data.title}</a><span class="faint mono"> · {fmtDate(n.data.date)}</span></li>
              ))}
            </ul>
          </>
        )}
      </aside>
    </div>
  </section>

  {pubs.length > 0 && (
    <section class="section" id="publications">
      <div class="shell">
        <h2 class="h2">Publications with the <b>lab</b>.</h2>
        <p class="small mt-2">{d.role === "director" ? "Lab output since Fall 2024 — the director's complete list is on " : "For the full list see "}<a href={d.links.scholar ?? d.links.website ?? "/publications/"} class="link-arrow" target="_blank" rel="noopener">{d.role === "director" ? "antoniomastropaolo.io" : d.links.scholar ? "Google Scholar" : d.links.website ? "their website" : "the publications index"}</a>.</p>
        <div class="mt-4"><PubList pubs={pubs} highlight={person.id} /></div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell"><a href="/people/" class="link-arrow"><ArrowLeft /> All people</a></div>
  </section>
</Base>

<style>
  .person-hero { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 760px) { .person-hero { grid-template-columns: 220px 1fr; gap: 48px; align-items: start; } }
  .ph-photo :global(.avatar) { border-radius: 12px; }
  .ph-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13.5px; }
  .ph-links a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-mute); }
  .ph-links a:hover { color: var(--accent); }
  .ph-links :global(svg) { width: 14px; height: 14px; }
  .person-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 1000px) { .person-grid { grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: 72px; } }
  .awards li { display: flex; align-items: flex-start; gap: 8px; padding: 8px 0; border-bottom: var(--hair) solid var(--line-soft); font-size: 14px; }
  .awards :global(svg) { width: 14px; height: 14px; color: var(--gold); flex-shrink: 0; margin-top: 3px; }
  .news-mini { padding: 8px 0; border-bottom: var(--hair) solid var(--line-soft); font-size: 14px; }
  .news-mini a { font-weight: 500; }
</style>
