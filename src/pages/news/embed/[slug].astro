---
/**
 * A news item without the site chrome, for the reader overlay on the landing
 * page. Carries the technical detail the card cannot: the paper behind the
 * item, its venue, identifiers, TL;DR and abstract.
 */
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { pubByKey, venueLabel, displayName, isReviewed } from "@/lib/pubs";
import { fmtDate } from "@/lib/dates";

export async function getStaticPaths() {
  const items = await getCollection("news", ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const pub = d.publication ? pubByKey(d.publication) : undefined;
const people = (await getCollection("people")).filter((p) => d.people.includes(p.id));
const threads = pub ? (await getCollection("research")).filter((t) => pub.threads?.includes(t.id)) : [];
const tldr = pub?.sources?.tldr;
---

<Base title={d.title} nav={false} footer={false} noindex class="embed">
  <article class="e">
    <header class="e-head">
      <p class="e-meta">
        <span class="m e-k">{d.kind.toUpperCase()}</span>
        <span class="m e-d">{fmtDate(d.date, { year: "numeric", month: "long", day: "numeric" }).toUpperCase()}</span>
        {d.pinned && <span class="m e-p">PINNED</span>}
      </p>
      <h1 class="e-t">{d.title}</h1>
    </header>

    <div class="e-cols">
    <div class:list={["e-body", { faces: people.length > 0 }]}>
      {people.length > 0 && (
        <aside class="e-people">
          {people.map((p) => (
            <a class="e-person" href={`/people/${p.id}/`} target="_top">
              {p.data.photo && <Image src={p.data.photo} alt={p.data.name} widths={[130, 260]} sizes="130px" loading="eager" />}
              <span class="e-pn">{p.data.name}</span>
              <span class="e-pr">{p.data.title ?? p.data.role}</span>
            </a>
          ))}
        </aside>
      )}
      <div class="prose e-prose"><Content /></div>
    </div>

    {pub && (
      <section class="e-pub">
        <h2 class="e-h2">The paper</h2>
        <p class="e-pt">{pub.title}</p>
        <p class="e-pa">{pub.authors.map((a) => displayName(a.name)).join(", ")}</p>

        <dl class="e-facts">
          <div><dt class="m">VENUE</dt><dd>{pub.venue_info?.name || pub.venue_raw || venueLabel(pub)}{isReviewed(pub) ? " · peer-reviewed" : pub.type === "preprint" ? " · preprint" : ""}</dd></div>
          <div><dt class="m">YEAR</dt><dd>{pub.year}</dd></div>
          {pub.doi && <div><dt class="m">DOI</dt><dd><a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">{pub.doi}</a></dd></div>}
          {pub.arxiv && <div><dt class="m">ARXIV</dt><dd><a href={`https://arxiv.org/abs/${pub.arxiv}`} target="_blank" rel="noopener">{pub.arxiv}</a></dd></div>}
          {(pub.citations?.count ?? 0) > 0 && <div><dt class="m">CITATIONS</dt><dd>{pub.citations!.count}</dd></div>}
          {threads.length > 0 && (
            <div><dt class="m">DIRECTIONS</dt><dd>{threads.map((t) => `${t.data.letter} · ${t.data.title}`).join(" / ")}</dd></div>
          )}
        </dl>

        {tldr && (
          <div class="e-tldr">
            <p class="m e-lab">TL;DR — AUTO-GENERATED BY SEMANTIC SCHOLAR</p>
            <p>{tldr}</p>
          </div>
        )}
        {/* No abstract here: the TL;DR says what the paper found, and the
            abstract is one click away on the paper page. Carrying it made a
            news item three screens tall. */}
      </section>
    )}
    </div>

    <footer class="e-foot">
      {/* No "open the full item": this overlay is the full item. Only the
          paper and the source live somewhere else. */}
      {pub && <a class="btn" href={`/publications/${pub.key}/`} target="_top">Paper page →</a>}
      {d.link && <a class:list={[pub ? "btn-o" : "btn"]} href={d.link} target="_blank" rel="noopener">Source ↗</a>}
      {!pub && !d.link && <a class="btn" href={`/news/${item.id}/`} target="_top">Open on its own page →</a>}
    </footer>
  </article>
</Base>

<style>
  .e { max-width: 780px; margin: 0 auto; padding: clamp(18px, 2.2vw, 28px) clamp(18px, 3vw, 32px) 26px; }
  @media (min-width: 1000px) { .e { max-width: 1180px; } }
  .e-head { padding-bottom: 14px; border-bottom: 1.5px solid var(--rule-3); }
  .e-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
  .e-k { font-size: 7.5px; letter-spacing: .1em; color: #fff; background: var(--ink); padding: 4px 7px; }
  .e-d { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); }
  .e-p { font-size: 7.5px; letter-spacing: .1em; color: var(--live); border: 1px solid rgba(194,65,12,.4); padding: 3px 6px; }
  .e-t {
    margin-top: 11px; font-variation-settings: "wdth" 114; font-weight: 800;
    font-size: clamp(21px, 2.5vw, 29px); line-height: 1.12; letter-spacing: -0.028em;
  }

  /* On a wide overlay the story and the paper stand side by side, so an item
     fits the frame instead of running past the bottom of it. */
  .e-cols { display: grid; gap: 26px; }
  @media (min-width: 1000px) {
    .e-cols { grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.9fr); gap: 36px; align-items: start; }
  }
  .e-body { display: grid; gap: 22px; margin-top: 18px; align-items: start; }
  /* The portrait rail only exists when there are portraits — without this
     guard the prose itself lands in the 130px column and wraps every three
     words. */
  @media (min-width: 680px) { .e-body.faces { grid-template-columns: 108px minmax(0, 1fr); gap: 24px; } }
  .e-people { display: grid; gap: 16px; }
  .e-person { display: block; }
  .e-person :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--rule); transition: border-color .22s ease; }
  .e-person:hover :global(img) { border-color: var(--rule-3); }
  .e-pn { display: block; margin-top: 8px; font-size: 13px; font-weight: 700; letter-spacing: -0.012em; }
  .e-person:hover .e-pn { color: var(--brand); }
  .e-pr { display: block; margin-top: 2px; font-size: 11.5px; color: var(--ink-4); line-height: 1.35; }
  .e-prose { font-size: 14px; line-height: 1.6; }
  .e-prose :global(p + p) { margin-top: 11px; }

  .e-pub { margin-top: 34px; padding-top: 22px; border-top: 1.5px solid var(--rule-3); }
  @media (min-width: 1000px) {
    .e-pub { margin-top: 18px; padding-top: 0; border-top: 0; border-left: 1px solid var(--rule); padding-left: 28px; }
  }
  .e-h2 { font-variation-settings: "wdth" 112; font-weight: 800; font-size: 17px; letter-spacing: -0.02em; }
  .e-pt { margin-top: 9px; font-size: 15px; font-weight: 700; line-height: 1.32; letter-spacing: -0.016em; }
  .e-pa { margin-top: 5px; font-size: 14px; color: var(--ink-4); }
  .e-facts { margin: 13px 0 0; display: grid; border-top: 1px solid var(--rule); }
  .e-facts > div { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .e-facts dt { font-size: 8px; letter-spacing: .11em; color: var(--ink-5); }
  .e-facts dd { margin: 0; font-size: 13px; color: var(--ink-2); }
  .e-facts dd a { border-bottom: 1px solid var(--rule-2); }
  .e-facts dd a:hover { color: var(--brand); border-color: var(--brand); }

  .e-lab { font-size: 8px; letter-spacing: .11em; color: var(--ink-5); }
  .e-tldr { margin-top: 15px; padding: 12px 14px; background: var(--bg-tint); border-left: 2px solid var(--brand); }
  .e-tldr p + p { margin-top: 6px; font-size: 13.5px; line-height: 1.58; color: var(--ink-2); }

  .e-foot { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 10px; }
  .e-foot .btn, .e-foot .btn-o { height: 36px; font-size: 13px; }
</style>
