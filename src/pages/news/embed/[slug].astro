---
/**
 * A news item without the site chrome, for the reader overlay on the landing
 * page and the news index. The overlay carries the story and the people in
 * it — nothing about the paper itself, which lives one click away on its own
 * record rather than being restated here.
 */
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { pubByKey } from "@/lib/pubs";
import { fmtDate } from "@/lib/dates";

export async function getStaticPaths() {
  const items = await getCollection("news", ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const pub = d.publication ? pubByKey(d.publication) : undefined;
const people = (await getCollection("people")).filter((p) => d.people.includes(p.id));
---

<Base title={d.title} nav={false} footer={false} noindex class="embed">
  <article class="e">
    <header class="e-head">
      <p class="e-meta">
        <span class="m e-k">{d.kind.toUpperCase()}</span>
        <span class="m e-d">{fmtDate(d.date, { year: "numeric", month: "long", day: "numeric" }).toUpperCase()}</span>
        {d.pinned && <span class="m e-p">PINNED</span>}
      </p>
      <h1 class="e-t">{d.title}</h1>
    </header>

    <div class:list={["e-body", { faces: people.length > 0 }]}>
      {people.length > 0 && (
        <aside class="e-people">
          {people.map((p) => (
            <a class="e-person" href={`/people/${p.id}/`} target="_top">
              {p.data.photo && <Image src={p.data.photo} alt={p.data.name} widths={[130, 260]} sizes="130px" loading="eager" />}
              <span class="e-pn">{p.data.name}</span>
              <span class="e-pr">{p.data.title ?? p.data.role}</span>
            </a>
          ))}
        </aside>
      )}
      <div class="prose e-prose"><Content /></div>
    </div>

    {/* No paper block: title, authors, venue, identifiers and TL;DR are the
        record's own job, and reproducing them here made the item three
        screens tall for no gain. The button goes straight there. */}
    <footer class="e-foot">
      {pub && <a class="btn" href={`/publications/${pub.key}/`} target="_top">Paper page →</a>}
      {d.link && <a class:list={[pub ? "btn-o" : "btn"]} href={d.link} target="_blank" rel="noopener">Source ↗</a>}
      {!pub && !d.link && <a class="btn" href={`/news/${item.id}/`} target="_top">Open on its own page →</a>}
    </footer>
  </article>
</Base>

<style>
  .e { max-width: 760px; margin: 0 auto; padding: clamp(18px, 2.2vw, 30px) clamp(18px, 3vw, 34px) 28px; }
  .e-head { padding-bottom: 14px; border-bottom: 1.5px solid var(--rule-3); }
  .e-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
  .e-k { font-size: 7.5px; letter-spacing: .1em; color: #fff; background: var(--ink); padding: 4px 7px; }
  .e-d { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); }
  .e-p { font-size: 7.5px; letter-spacing: .1em; color: var(--live); border: 1px solid rgba(194,65,12,.4); padding: 3px 6px; }
  .e-t {
    margin-top: 11px; font-variation-settings: "wdth" 114; font-weight: 800;
    font-size: clamp(22px, 2.6vw, 30px); line-height: 1.12; letter-spacing: -0.028em;
  }

  .e-body { display: grid; gap: 22px; margin-top: 20px; align-items: start; }
  /* The portrait rail only exists when there are portraits — without this
     guard the prose itself lands in the 108px column and wraps every three
     words. */
  @media (min-width: 680px) { .e-body.faces { grid-template-columns: 108px minmax(0, 1fr); gap: 26px; } }
  .e-people { display: grid; gap: 16px; }
  .e-person { display: block; }
  .e-person :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--rule); transition: border-color .22s ease; }
  .e-person:hover :global(img) { border-color: var(--rule-3); }
  .e-pn { display: block; margin-top: 8px; font-size: 13px; font-weight: 700; letter-spacing: -0.012em; }
  .e-person:hover .e-pn { color: var(--brand); }
  .e-pr { display: block; margin-top: 2px; font-size: 11.5px; color: var(--ink-4); line-height: 1.35; }
  .e-prose { font-size: 14.5px; line-height: 1.62; }
  .e-prose :global(p + p) { margin-top: 12px; }

  .e-foot { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: 10px; }
  .e-foot .btn, .e-foot .btn-o { height: 36px; font-size: 13px; }
</style>
