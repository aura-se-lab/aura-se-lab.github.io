---
/**
 * A news item without the site chrome, for the reader overlay on the landing
 * page and the news index. The overlay carries the story and the people in
 * it — nothing about the paper itself, which lives one click away on its own
 * record rather than being restated here.
 */
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { pubByKey } from "@/lib/pubs";
import { fmtDate } from "@/lib/dates";

export async function getStaticPaths() {
  const items = await getCollection("news", ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const pub = d.publication ? pubByKey(d.publication) : undefined;
const people = (await getCollection("people")).filter((p) => d.people.includes(p.id));
---

<Base title={d.title} nav={false} footer={false} noindex class="embed">
  <article class="e">
    <header class="e-head">
      <p class="e-meta">
        <span class="m e-k">{d.kind.toUpperCase()}</span>
        <span class="m e-d">{fmtDate(d.date, { year: "numeric", month: "long", day: "numeric" }).toUpperCase()}</span>
        {d.pinned && <span class="m e-p">PINNED</span>}
      </p>
      <h1 class="e-t">{d.title}</h1>
    </header>

    <div class="e-body">
      {/* A horizontal byline strip rather than a stacked rail. Three portraits
          down the side made an item 300px taller than a one-portrait item, and
          no single box size can serve both. */}
      {people.length > 0 && (
        <aside class="e-people">
          {people.map((p) => (
            <a class="e-person" href={`/people/${p.id}/`} target="_top">
              {p.data.photo && <Image src={p.data.photo} alt={p.data.name} widths={[128, 256]} sizes="64px" loading="eager" />}
              <span class="e-pt">
                <span class="e-pn">{p.data.name}</span>
                <span class="e-pr">{p.data.title ?? p.data.role}</span>
              </span>
            </a>
          ))}
        </aside>
      )}
      <div class="prose e-prose"><Content /></div>
    </div>

    {/* No paper block: title, authors, venue, identifiers and TL;DR are the
        record's own job, and reproducing them here made the item three
        screens tall for no gain. The button goes straight there. */}
    <footer class="e-foot">
      {pub && <a class="btn" href={`/publications/${pub.key}/`} target="_top">Paper page →</a>}
      {d.link && <a class:list={[pub ? "btn-o" : "btn"]} href={d.link} target="_blank" rel="noopener">Source ↗</a>}
      {!pub && !d.link && <a class="btn" href={`/news/${item.id}/`} target="_top">Open on its own page →</a>}
    </footer>
  </article>
</Base>

<style>
  /* The reader box is one fixed size for every item. Rather than let the
     content decide the height, the whole item is drawn at a single scale
     `--k`, tuned so the longest of the thirteen items still fits. Change one
     number here and the title, byline, prose and footer move together. */
  .e {
    /* Three scales, because the parts do not cost the same. The furniture is
       fixed height and pays for itself once; the prose is what people read;
       a portrait costs one row however big it is. Tuned so the longest of the
       thirteen items fits the 726x557 the reader box leaves it, with a few
       pixels to spare. */
    --k:  0.65;  /* title, byline text, footer, all the spacing */
    --kp: 0.72;  /* the prose */
    --kf: 0.85;  /* the byline portraits */
    /* The panel is the width of the prose measure (.prose caps at 74ch), so
       the rules under the title and byline end where the text does rather
       than running past it. */
    max-width: 540px; margin: 0 auto;
    padding: calc(14px * var(--k)) calc(26px * var(--k)) calc(16px * var(--k));
    /* The box is one fixed size and never resizes to the item. If an item
       ever outgrows it, the prose scrolls inside; the title, the byline and
       the button to the record stay put. */
    height: 100dvh; display: flex; flex-direction: column;
  }
  .e-head { padding-bottom: calc(12px * var(--k)); border-bottom: 1.5px solid var(--rule-3); }
  .e-meta { display: flex; flex-wrap: wrap; align-items: center; gap: calc(9px * var(--k)); }
  .e-k { font-size: max(7px, calc(7.5px * var(--k))); letter-spacing: .1em; color: #fff; background: var(--ink); padding: 4px 7px; }
  .e-d { font-size: max(7.5px, calc(8.5px * var(--k))); letter-spacing: .09em; color: var(--ink-5); }
  .e-p { font-size: max(7px, calc(7.5px * var(--k))); letter-spacing: .1em; color: var(--live); border: 1px solid rgba(194,65,12,.4); padding: 3px 6px; }
  .e-t {
    margin-top: calc(9px * var(--k)); font-variation-settings: "wdth" 114; font-weight: 800;
    font-size: calc(27px * var(--k)); line-height: 1.12; letter-spacing: -0.028em;
  }

  .e-body { margin-top: calc(18px * var(--k)); flex: 1; min-height: 0; display: flex; flex-direction: column; }
  /* One row, wrapping: an item with three people is a line taller than one
     with a single person, not three hundred pixels taller. */
  .e-people {
    display: flex; flex-wrap: wrap; gap: calc(10px * var(--k)) calc(26px * var(--k));
    padding-bottom: calc(13px * var(--k)); margin-bottom: calc(14px * var(--k));
    border-bottom: 1px solid var(--rule);
  }
  .e-person { display: flex; align-items: center; gap: calc(13px * var(--k)); min-width: 0; }
  .e-person :global(img) {
    flex: 0 0 auto; width: calc(64px * var(--kf)); height: calc(64px * var(--kf));
    aspect-ratio: 1; object-fit: cover;
    object-position: top center; border: 1px solid var(--rule); transition: border-color .22s ease;
  }
  .e-person:hover :global(img) { border-color: var(--rule-3); }
  .e-pt { min-width: 0; }
  .e-pn { display: block; font-size: calc(14px * var(--k)); font-weight: 700; letter-spacing: -0.014em; }
  .e-person:hover .e-pn { color: var(--brand); }
  .e-pr { display: block; margin-top: 2px; font-size: calc(12px * var(--k)); color: var(--ink-4); line-height: 1.3; }
  .e-prose { font-size: calc(15.5px * var(--kp)); line-height: 1.6; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .e-prose :global(p + p) { margin-top: calc(12px * var(--kp)); }

  .e-foot { flex: 0 0 auto; margin-top: calc(16px * var(--k)); padding-top: calc(13px * var(--k)); border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: calc(10px * var(--k)); }
  .e-foot .btn, .e-foot .btn-o { height: calc(36px * var(--k)); padding: 0 calc(18px * var(--k)); font-size: calc(13px * var(--k)); }
</style>
