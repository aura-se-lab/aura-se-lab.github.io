---
/**
 * The news archive. Not a blog dump: 13 items rendered in full made a page
 * nobody could scan. This is an index — one row per item, filterable by kind
 * and year, opening the same overlay reader the landing page uses.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Cover from "@/components/Cover.astro";
import { pubByKey, venueLabel, shortName } from "@/lib/pubs";
import { fmtDate } from "@/lib/dates";
import { Rss } from "@lucide/astro";

const items = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const people = await getCollection("people");

const covers = import.meta.glob<{ default: ImageMetadata }>("../../assets/papers/*.jpg", { eager: true });
const coverOf = (key?: string) => (key ? covers[`../../assets/papers/${key}.jpg`]?.default : undefined);

const KIND: Record<string, string> = {
  paper: "Paper", award: "Award", grant: "Funding", people: "People",
  talk: "Talk", service: "Service", event: "Event", misc: "News",
};

/** First sentence of the body, markup stripped. */
const blurb = (body: string, max = 165) => {
  const t = body
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*_`>#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (t.length <= max) return t;
  const cut = t.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(" ")) + "…";
};

/** Surnames, at most three, then et al. */
const byline = (names: string[]) => {
  const s = names.map((n) => shortName(n).split(" ").pop() ?? n);
  return s.length > 3 ? `${s.slice(0, 3).join(", ")} et al.` : s.join(", ");
};

const rows = items.map((n) => {
  const pub = n.data.publication ? pubByKey(n.data.publication) : undefined;
  const face = people.find((p) => p.id === n.data.people[0]);
  return {
    id: n.id,
    d: n.data,
    year: n.data.date.getUTCFullYear(),
    pub,
    cover: coverOf(n.data.publication),
    face: pub ? undefined : face,
    /* A paper item's headline already says what happened, so the line under
       it is the record — title, byline, venue — rather than a sentence of
       prose restating the headline in other words. */
    cite: pub
      ? { title: pub.title, who: byline(pub.authors.map((a) => a.name)), where: `${venueLabel(pub)} ${pub.year}` }
      : undefined,
    text: pub ? "" : blurb(n.body ?? ""),
  };
});

const years = [...new Set(rows.map((r) => r.year))].sort((a, b) => b - a);
const kinds = [...new Set(rows.map((r) => r.d.kind))]
  .map((k) => ({ v: k, l: KIND[k] ?? k, c: rows.filter((r) => r.d.kind === k).length }))
  .sort((a, b) => b.c - a.c);
---

<Base
  title="News"
  description="News from the AURA Lab at William & Mary: paper acceptances, awards, funding and new members."
  image="/og/news.png"
>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <div class="row">
          <h1 class="h2">News</h1>
          <a href="/rss.xml" class="rss"><Rss /> RSS</a>
        </div>
        <p class="lead" style="max-width:64ch">
          Acceptances, awards, funding and people. Click an item to read it here.
        </p>
      </header>

      {/* One row of filters, not two: the kinds and the years used to sit on
          separate lines, each opening with its own "All 13". */}
      <div class="bar">
        <div class="chips">
          <button class="chip on" type="button" data-k="all">All <span class="m">{rows.length}</span></button>
          {kinds.map((k) => (
            <button class="chip" type="button" data-k={k.v}>{k.l} <span class="m">{k.c}</span></button>
          ))}
        </div>
        <div class="ix">
          <span class="m ix-l">YEAR</span>
          {years.map((y) => (
            <button class="ixb" type="button" data-y={String(y)}>
              {y} <span class="m">{rows.filter((r) => r.year === y).length}</span>
            </button>
          ))}
        </div>
      </div>

      <ol class="feed" id="feed">
        {rows.map((r, i) => (
          <li class="row" data-y={String(r.year)} data-k={r.d.kind}>
            <button type="button" data-embed={`/news/embed/${r.id}/`} data-title={r.d.title}>
              <span class="thumb">
                {r.pub ? (
                  <Cover pub={r.pub} cover={r.cover} widths={[110, 220]} sizes="72px" />
                ) : r.face?.data.photo ? (
                  <Image src={r.face.data.photo} alt="" widths={[110, 220]} sizes="72px" />
                ) : (
                  <span class="th-k m">{(KIND[r.d.kind] ?? r.d.kind).toUpperCase()}</span>
                )}
              </span>
              <span class="body">
                {/* No running number, and no PAPER badge on the nine rows
                    out of thirteen that are papers — the cover beside it and
                    the filter above it both already say so. The badge earns
                    its place only where the kind is the surprise. */}
                <span class="top">
                  <span class="m dt">{fmtDate(r.d.date).toUpperCase()}</span>
                  {r.d.kind !== "paper" && <span class="m kd">{(KIND[r.d.kind] ?? r.d.kind).toUpperCase()}</span>}
                </span>
                <span class="t">{r.d.title}</span>
                {r.cite ? (
                  <span class="cite">
                    <span class="ci-t">{r.cite.title}</span>
                    <span class="ci-m">{r.cite.who} · {r.cite.where}</span>
                  </span>
                ) : (
                  <span class="b">{r.text}</span>
                )}
              </span>
              <span class="go" aria-hidden="true">→</span>
            </button>
          </li>
        ))}
      </ol>
      <p class="none" id="none" hidden>Nothing matches those filters.</p>
    </div>
  </div>

  <div class="reader" id="nreader" hidden>
    <div class="r-back" data-close></div>
    <div class="r-box" role="dialog" aria-modal="true" aria-labelledby="nr-title">
      <header class="r-head">
        <div class="r-h-t">
          <p class="m r-h-v">NEWS</p>
          <h2 id="nr-title"></h2>
        </div>
        <button class="r-x" type="button" data-close aria-label="Close">✕</button>
      </header>
      <div class="r-body">
        <div class="r-load" id="nr-load"><span></span>Loading…</div>
        <iframe id="nr-frame" title="News item"></iframe>
      </div>
    </div>
  </div>
</Base>

<style>
  .rss { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--ink-4); }
  .rss:hover { color: var(--brand); }
  .rss :global(svg) { width: 14px; height: 14px; }

  /* ── filters, in the same language as the publications grid ────────────── */
  .bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 12px 24px; padding-bottom: 16px;
  }
  .ix { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .ix-l { font-size: 8px; letter-spacing: .12em; color: var(--ink-5); margin-right: 8px; }
  .ixb {
    display: inline-flex; align-items: baseline; gap: 5px; padding: 5px 9px;
    font-size: 14px; font-weight: 700; color: var(--ink-4); border-radius: 2px;
  }
  .ixb .m { font-size: 8px; color: var(--ink-5); }
  .ixb:hover { color: var(--ink); background: var(--bg-soft); }
  .ixb.on { color: #fff; background: var(--ink); }
  .ixb.on .m { color: rgba(255,255,255,.6); }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    display: inline-flex; align-items: baseline; gap: 6px; height: 30px; padding: 0 11px;
    border: 1px solid var(--rule-2); font-size: 13px; font-weight: 700; color: var(--ink-3);
  }
  .chip .m { font-size: 8px; color: var(--ink-5); }
  .chip:hover { border-color: var(--rule-3); color: var(--ink); }
  .chip.on { background: var(--ink); border-color: var(--ink); color: #fff; }
  .chip.on .m { color: rgba(255,255,255,.6); }

  /* ── the feed ──────────────────────────────────────────────────────────── */
  .feed { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1.5px solid var(--rule-3); }
  .row[hidden] { display: none; }
  .row + .row { border-top: 1px solid var(--rule); }
  .row > button {
    display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; align-items: start;
    gap: 20px; width: 100%; padding: 18px 6px; text-align: left;
    transition: background .18s ease, padding .18s ease;
  }
  .row > button:hover { background: var(--bg-soft); padding-left: 12px; padding-right: 0; }

  .thumb {
    display: block; position: relative; width: 72px; aspect-ratio: 17 / 22; container-type: inline-size;
    background: var(--bg-tint); border: 1px solid var(--rule); overflow: hidden;
  }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .th-k {
    position: absolute; inset: 0; display: grid; place-items: center; padding: 4px;
    font-size: 7.5px; letter-spacing: .1em; color: var(--ink-5); text-align: center;
  }

  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
  .dt { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); }
  .kd { font-size: 7.5px; letter-spacing: .09em; color: #fff; background: var(--ink); padding: 3px 6px; }
  .t {
    display: block; margin-top: 7px; font-size: clamp(16px, 1.5vw, 19px); font-weight: 700;
    line-height: 1.26; letter-spacing: -0.018em; font-variation-settings: "wdth" 106;
  }
  .row > button:hover .t { color: var(--brand); }
  .b {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin-top: 6px; font-size: 14px; line-height: 1.55; color: var(--ink-4); max-width: 78ch;
  }
  /* A paper row carries the record instead of a paraphrase of its own
     headline: the title as published, then who wrote it and where. */
  .cite { display: block; margin-top: 7px; max-width: 82ch; }
  .ci-t {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 14px; line-height: 1.5; color: var(--ink-3);
  }
  .ci-m { display: block; margin-top: 3px; font-size: 12.5px; line-height: 1.45; color: var(--ink-5); }
  .go { align-self: center; font-size: 16px; color: var(--ink-5); transition: transform .18s ease, color .18s ease; }
  .row > button:hover .go { transform: translateX(4px); color: var(--brand); }

  .none { margin-top: 26px; color: var(--ink-4); }

  @media (max-width: 640px) {
    .row > button { grid-template-columns: 56px minmax(0, 1fr); gap: 14px; }
    .thumb { width: 56px; }
    .go { display: none; }
  }

  /* ── reader ────────────────────────────────────────────────────────────── */
  .reader { position: fixed; inset: 0; z-index: 400; display: grid; place-items: center; padding: 3vh 3vw; }
  .r-back { position: absolute; inset: 0; background: rgba(5,5,5,.62); backdrop-filter: blur(2px); }
  .r-box {
    position: relative; display: flex; flex-direction: column; width: min(900px, 100%); height: min(92vh, 100%);
    background: var(--bg); border: 1px solid var(--rule-3); box-shadow: 0 40px 90px -30px rgba(5,5,5,.6);
  }
  .r-head { display: flex; align-items: center; gap: 20px; padding: 14px 18px; border-bottom: 1px solid var(--rule); }
  .r-h-t { min-width: 0; }
  .r-h-v { font-size: 8px; letter-spacing: .1em; color: var(--brand); }
  /* The item below carries the title as its heading; the bar keeps it only for
     the dialog's accessible name. */
  .r-head h2 {
    position: absolute; width: 1px; height: 1px; margin: -1px;
    padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .r-x { margin-left: auto; width: 34px; height: 34px; border: 1px solid var(--rule-2); font-size: 14px; }
  .r-x:hover { border-color: var(--rule-3); background: var(--bg-soft); }
  .r-body { position: relative; flex: 1; min-height: 0; background: var(--bg); }
  .r-body iframe { width: 100%; height: 100%; border: 0; display: block; }
  .r-load { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 10px; font-size: 13px; color: var(--ink-4); }
  .r-load span { width: 22px; height: 22px; border: 2px solid var(--rule-2); border-top-color: var(--brand); border-radius: 50%; animation: sp .8s linear infinite; }
  @keyframes sp { to { transform: rotate(360deg); } }
  body.lock { overflow: hidden; }
</style>

<script>
  const feed = document.getElementById("feed")!;
  const rows = [...feed.querySelectorAll<HTMLElement>(".row")];
  const noneEl = document.getElementById("none") as HTMLElement;
  const ixb = [...document.querySelectorAll<HTMLElement>(".ixb")];
  const chips = [...document.querySelectorAll<HTMLElement>(".chip")];
  let year = "all";
  let kind = "all";

  function render() {
    let shown = 0;
    for (const r of rows) {
      const ok = (year === "all" || r.dataset.y === year) && (kind === "all" || r.dataset.k === kind);
      r.hidden = !ok;
      if (ok) shown++;
    }
    noneEl.hidden = shown > 0;
    for (const b of ixb) b.classList.toggle("on", b.dataset.y === year);
    for (const c of chips) c.classList.toggle("on", c.dataset.k === kind);
  }
  // With the duplicate "All 13" gone from the year row, a ticked year clears
  // itself: click it again and the filter is off.
  for (const b of ixb)
    b.addEventListener("click", () => {
      year = year === b.dataset.y ? "all" : b.dataset.y!;
      render();
    });
  for (const c of chips) c.addEventListener("click", () => { kind = c.dataset.k!; render(); });
  render();

  // ── reader ────────────────────────────────────────────────────────────────
  const reader = document.getElementById("nreader") as HTMLElement;
  const frame = document.getElementById("nr-frame") as HTMLIFrameElement;
  const title = document.getElementById("nr-title") as HTMLElement;
  const load = document.getElementById("nr-load") as HTMLElement;
  let last: HTMLElement | null = null;

  function open(btn: HTMLElement) {
    last = btn;
    title.textContent = btn.dataset.title ?? "";
    load.hidden = false;
    frame.src = btn.dataset.embed!;
    reader.hidden = false;
    document.body.classList.add("lock");
    frame.addEventListener("load", () => { load.hidden = true; }, { once: true });
  }
  function close() {
    reader.hidden = true;
    frame.src = "about:blank";
    document.body.classList.remove("lock");
    last?.focus();
  }
  feed.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-embed]");
    if (btn) open(btn);
  });
  reader.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-close]")) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !reader.hidden) close();
  });
</script>
