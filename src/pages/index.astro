---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Reach from "@/components/Reach.astro";
import { lab, foundedLabel } from "@/lib/lab";
import { publications, metrics } from "@/lib/pubs";
import { fmtDate } from "@/lib/dates";

const threads = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order);
const people = await getCollection("people");
const current = people.filter((p) => p.data.status === "current");

const news = (await getCollection("news"))
  .filter((n) => !n.data.draft)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || +b.data.date - +a.data.date);
const recent = news.slice(0, 5);
const [lead, ...rest] = recent;

/** A news item about a paper can borrow that paper's first page. */
const covers = import.meta.glob<{ default: ImageMetadata }>("../assets/papers/*.jpg", { eager: true });
const coverFor = (key?: string) => (key ? covers[`../assets/papers/${key}.jpg`]?.default : undefined);
const leadCover = coverFor(lead?.data.publication);

/** First sentence of an item's body, with the markup taken out. */
const blurb = (body: string, max = 190) => {
  const t = body
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*_`>#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (t.length <= max) return t;
  const cut = t.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(" ")) + "…";
};

// Papers with an arXiv copy — not the same set as the preprint bucket, which
// now means work that has not been accepted anywhere yet.
const arxivCount = publications.filter((p) => p.arxiv).length;

const stats = [
  { n: String(metrics.total), l: "PUBLICATIONS", href: "/publications/" },
  { n: String(metrics.reviewed), l: "PEER-REVIEWED", href: "/publications/?kind=reviewed" },
  { n: String(current.length), l: "LAB MEMBERS", href: "/people/" },
  { n: foundedLabel.split(" ")[1], l: "FOUNDED " + foundedLabel.split(" ")[0].toUpperCase(), href: "/research/" },
];
---

<Base footer={false} class="home" description={lab.brief[0]}>
  <div class="screen">
    <div class="aura" aria-hidden="true"><i class="a1"></i><i class="a2"></i></div>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="shell screen-in">
      <div class="left">
        <p class="kicker rv" style="--i:0">
          <span class="pulse" aria-hidden="true"></span>
          {lab.institution.name.toUpperCase()} · DEPARTMENT OF COMPUTER SCIENCE · EST. {foundedLabel.toUpperCase()}
        </p>

        <h1 class="display hero rv" style="--i:1">
          <span class="ln"><b data-l="0">A</b>I for</span>
          <span class="ln"><b data-l="1">U</b>nderstandable and</span>
          <span class="ln"><b data-l="2">R</b>esponsible</span>
          <span class="ln"><b data-l="3">A</b>utomation<span class="tail"> in Software Engineering</span></span>
        </h1>

        <p class="lead brief rv" style="--i:2">{lab.brief[0]}</p>

        <div class="cta rv" style="--i:3">
          <a class="btn" href="/research/">Research</a>
          <a class="btn-o" href="/publications/">Publications</a>
          <a class="btn-o" href="/join/">Join the lab</a>
        </div>

        <div class="stats rv" style="--i:4">
          {stats.map((s) => (
            <a class="stat" href={s.href}>
              <span class="stat-n num">{s.n}</span>
              <span class="stat-l m">{s.l}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="right">
        <p class="label rv" style="--i:2">FOUR RESEARCH DIRECTIONS</p>
        <ul class="areas">
          {threads.map((t, i) => (
            <li class="rv" style={`--i:${3 + i}`}>
              <a class="area" href={`/research/${t.id}/`} data-l={String(i)} style={`--c:var(--a${i + 1})`}>
                <span class="area-t">
                  <span class="area-h">{t.data.title}</span>
                  <span class="area-s">{t.data.short.split(/[—.]/)[0].trim()}</span>
                </span>
                <span class="area-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="rail">
      <div class="shell rail-in">
        <a class="rail-cue" href="#news">
          <span class="rail-tag m">NEWS</span>
          <span class="rail-t">What the lab has been up to, and how to reach us</span>
          <span class="rail-ar" aria-hidden="true">↓</span>
        </a>
        <div class="rail-r">
          <span class="rail-meta m">
            {metrics.total} PUBLICATIONS · {arxivCount} PAPERS ON ARXIV · SYNCED {fmtDate(metrics.updated).toUpperCase()}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── news ───────────────────────────────────────────────────────────── -->
  <section class="news" id="news">
    <div class="shell">
      <header class="news-head">
        <h2 class="h2">Recent news</h2>
        <a class="news-all" href="/news/">All news →</a>
      </header>

      <div class="nwrap">
        {lead && (
          <button class="nlead" type="button" data-embed={`/news/embed/${lead.id}/`} data-title={lead.data.title}>
            {leadCover && (
              <span class="nl-cover">
                <Image src={leadCover} alt="" widths={[190, 380]} sizes="190px" loading="lazy" />
              </span>
            )}
            <span class="nl-text">
              <span class="nl-top">
                <span class="m nl-k">{lead.data.kind.toUpperCase()}</span>
                <span class="m nl-d">{fmtDate(lead.data.date).toUpperCase()}</span>
                {lead.data.pinned && <span class="m nl-p">● LATEST</span>}
              </span>
              <span class="nl-t">{lead.data.title}</span>
              <span class="nl-b">{blurb(lead.body ?? "")}</span>
              <span class="nl-go">Read the story →</span>
            </span>
          </button>
        )}

        <ol class="nlist">
          {rest.map((n, i) => (
            <li class="nitem">
              <button type="button" data-embed={`/news/embed/${n.id}/`} data-title={n.data.title}>
                <span class="m n-i">{String(i + 2).padStart(2, "0")}</span>
                <span class="n-body">
                  <span class="n-meta">
                    <span class="m n-d">{fmtDate(n.data.date).toUpperCase()}</span>
                    <span class="m n-k">{n.data.kind.toUpperCase()}</span>
                  </span>
                  <span class="n-t">{n.data.title}</span>
                </span>
                <span class="n-go" aria-hidden="true">→</span>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Reach />

  <div class="reader" id="nreader" hidden>
    <div class="r-back" data-close></div>
    <div class="r-box" role="dialog" aria-modal="true" aria-labelledby="nr-title">
      <header class="r-head">
        <div class="r-h-t">
          <p class="m r-h-v">NEWS</p>
          <h2 id="nr-title"></h2>
        </div>
        <button class="r-x" type="button" data-close aria-label="Close">✕</button>
      </header>
      <div class="r-body">
        <div class="r-load" id="nr-load"><span></span>Loading…</div>
        <iframe id="nr-frame" title="News item"></iframe>
      </div>
    </div>
  </div>
</Base>

<style>
  .screen {
    position: relative; overflow: hidden;
    min-height: calc(100dvh - var(--nav-h));
    display: flex; flex-direction: column;
  }
  .screen-in {
    flex: 1; width: 100%;
    display: grid; grid-template-columns: minmax(0, 1.34fr) minmax(360px, 0.86fr);
    gap: clamp(28px, 4vw, 76px); align-items: center;
    padding-top: clamp(20px, 3vh, 44px); padding-bottom: clamp(20px, 3vh, 44px);
    position: relative; z-index: 2;
  }

  /* ── background ────────────────────────────────────────────────────────── */
  .grid-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(11,15,13,.075) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse 120% 90% at 62% 40%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 120% 90% at 62% 40%, #000 20%, transparent 78%);
  }
  .aura { position: absolute; inset: -20% -10%; z-index: 0; pointer-events: none; filter: blur(70px); opacity: .5; }
  .aura i { position: absolute; display: block; border-radius: 50%; }
  .a1 { width: 46vw; height: 46vw; left: 44%; top: -12%; background: radial-gradient(circle, rgba(0,144,81,.30), transparent 68%); animation: drift1 26s ease-in-out infinite; }
  .a2 { width: 38vw; height: 38vw; left: 62%; top: 34%; background: radial-gradient(circle, rgba(23,72,90,.26), transparent 68%); animation: drift2 32s ease-in-out infinite; }
  @keyframes drift1 { 0%,100% { transform: translate3d(0,0,0) scale(1); } 50% { transform: translate3d(-6%,7%,0) scale(1.12); } }
  @keyframes drift2 { 0%,100% { transform: translate3d(0,0,0) scale(1.06); } 50% { transform: translate3d(7%,-8%,0) scale(.94); } }

  /* ── left ──────────────────────────────────────────────────────────────── */
  .kicker { display: flex; align-items: center; gap: 9px; font-size: max(8.5px, 0.42vw); color: var(--ink-4); }
  .pulse { width: 6px; height: 6px; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 0 rgba(194,65,12,.55); animation: pulse 2.6s ease-out infinite; flex-shrink: 0; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(194,65,12,.5); } 70% { box-shadow: 0 0 0 9px rgba(194,65,12,0); } 100% { box-shadow: 0 0 0 0 rgba(194,65,12,0); } }

  .hero { margin-top: clamp(16px, 1.4vh, 26px); font-size: clamp(34px, 4.5vw, 108px); }
  .ln { display: block; }
  .hero b { font-weight: 800; color: var(--brand); position: relative; transition: color .28s ease; }
  .hero b.hot { color: var(--live); }
  .tail { font-weight: 300; color: var(--ink-3); font-variation-settings: "wdth" 100; letter-spacing: -0.02em; }

  .brief { margin-top: clamp(14px, 2vh, 26px); max-width: 58ch; font-size: clamp(16px, 1.02vw, 23px); }
  .cta { margin-top: clamp(18px, 2.4vh, 30px); display: flex; flex-wrap: wrap; gap: 10px; }
  .stats {
    margin-top: clamp(20px, 3vh, 38px); display: flex; flex-wrap: wrap; gap: 0;
    border-top: 1.5px solid var(--rule-3);
  }
  .stat { padding: clamp(14px, 1.1vw, 22px) clamp(24px, 2vw, 46px) 6px 0; margin-right: clamp(24px, 2vw, 46px); border-right: 1px solid var(--rule); display: block; }
  .stat:last-child { border-right: 0; }
  .stat-n { display: block; font-variation-settings: "wdth" 112; font-weight: 700; font-size: clamp(26px, 2.2vw, 54px); letter-spacing: -0.03em; line-height: 1; transition: color .2s ease; }
  .stat:hover .stat-n { color: var(--brand); }
  .stat-l { display: block; margin-top: 7px; font-size: max(8px, 0.4vw); letter-spacing: .1em; color: var(--ink-5); }

  /* ── right ─────────────────────────────────────────────────────────────── */
  .right { min-width: 0; }
  .right .label { font-size: max(8.5px, 0.42vw); }
  .areas { margin-top: 12px; display: grid; gap: clamp(8px, 0.5vw, 14px); }
  .area {
    display: grid; grid-template-columns: minmax(0, 1fr) 20px; align-items: center; gap: clamp(14px, 0.9vw, 22px);
    padding: clamp(13px, 1vw, 24px) clamp(15px, 1.1vw, 26px); background: rgba(255,255,255,.72); border: 1px solid var(--rule);
    backdrop-filter: blur(6px);
    transition: border-color .24s ease, transform .24s cubic-bezier(.2,.8,.25,1), background .24s ease;
  }
  .area:hover { border-color: var(--c); transform: translateX(5px); background: #fff; }
  .area-t { min-width: 0; }
  .area-h { display: block; font-weight: 700; font-size: clamp(14px, 0.72vw, 20px); line-height: 1.25; letter-spacing: -0.012em; font-variation-settings: "wdth" 106; }
  .area-s { display: block; margin-top: 4px; font-size: clamp(12.2px, 0.6vw, 16.5px); line-height: 1.35; color: var(--ink-4); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .area-go { color: var(--ink-5); transition: transform .24s ease, color .24s ease; }
  .area:hover .area-go { color: var(--c); transform: translateX(3px); }

  /* ── bottom rail ───────────────────────────────────────────────────────── */
  .rail { position: relative; z-index: 2; border-top: 1px solid var(--rule); background: rgba(255,255,255,.8); backdrop-filter: blur(8px); }
  .rail-in { display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; min-height: clamp(52px, 4vh, 72px); padding-top: 8px; padding-bottom: 8px; flex-wrap: wrap; }
  .rail-cue { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .rail-ar { color: var(--ink-5); transition: transform .3s cubic-bezier(.2,.8,.25,1), color .2s ease; }
  .rail-cue:hover .rail-ar { transform: translateY(3px); color: var(--brand); }
  .rail-cue:hover .rail-t { color: var(--brand); }
  .rail-tag { font-size: 8px; letter-spacing: .1em; color: #fff; background: var(--ink); padding: 4px 7px; flex-shrink: 0; }
  .rail-t { font-size: clamp(14px, 0.72vw, 19px); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rail-r { display: flex; align-items: center; gap: 22px; margin-left: auto; }
  .rail-meta { font-size: 8px; letter-spacing: .09em; color: var(--ink-5); }

  /* ── news ──────────────────────────────────────────────────────────────── */
  .news { padding: clamp(38px, 4.5vw, 72px) 0 clamp(46px, 5.5vw, 88px); }
  .news-head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 14px 26px; flex-wrap: wrap;
    padding-bottom: 18px; border-bottom: 1.5px solid var(--rule-3);
  }
  .news-all { font-size: 15px; font-weight: 600; border-bottom: 1px solid var(--rule-2); padding-bottom: 2px; }
  .news-all:hover { color: var(--brand); border-color: var(--brand); }

  .nwrap { margin-top: 26px; display: grid; gap: 24px; align-items: stretch; }
  @media (min-width: 960px) { .nwrap { grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 34px; } }

  /* ── the lead ──────────────────────────────────────────────────────────── */
  .nlead {
    position: relative; width: 100%; text-align: left; cursor: pointer; overflow: hidden;
    display: grid; gap: clamp(18px, 1.6vw, 26px); align-items: start;
    padding: clamp(20px, 2vw, 30px);
    background: var(--bg-soft); border: 1px solid var(--rule);
    transition: border-color .3s ease, transform .3s cubic-bezier(.2,.8,.25,1), background .3s ease, box-shadow .3s ease;
  }
  @media (min-width: 560px) { .nlead { grid-template-columns: clamp(120px, 12vw, 190px) minmax(0, 1fr); } }
  .nlead::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--brand);
    transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.2,.8,.25,1);
  }
  .nlead:hover { border-color: var(--rule-3); transform: translateY(-4px); background: #fff; box-shadow: 0 26px 44px -30px rgba(11,15,13,.5); }
  .nlead:hover::before { transform: scaleX(1); }
  .nl-cover { display: block; }
  .nl-cover :global(img) {
    width: 100%; height: auto; aspect-ratio: 17/22; object-fit: cover; object-position: top center;
    border: 1px solid var(--rule); background: #fff;
    transition: transform .4s cubic-bezier(.2,.8,.25,1), border-color .3s ease;
  }
  .nlead:hover .nl-cover :global(img) { transform: translateY(-2px); border-color: var(--rule-2); }
  .nl-text { display: flex; flex-direction: column; min-width: 0; height: 100%; }
  .nl-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .nl-k { font-size: 7.5px; letter-spacing: .1em; color: #fff; background: var(--ink); padding: 4px 7px; }
  .nl-d { font-size: 8.5px; letter-spacing: .09em; color: var(--ink-5); }
  .nl-p { font-size: 7.5px; letter-spacing: .1em; color: var(--live); }
  .nl-t {
    display: block; margin-top: 14px; font-variation-settings: "wdth" 112; font-weight: 800;
    font-size: clamp(20px, 1.62vw, 31px); line-height: 1.14; letter-spacing: -0.026em; color: var(--ink);
  }
  .nlead:hover .nl-t { color: var(--brand-dk); }
  .nl-b {
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
    margin-top: 11px; font-size: clamp(13.5px, 0.85vw, 15.5px); line-height: 1.6; color: var(--ink-3);
  }
  .nl-go { margin-top: auto; padding-top: 20px; font-size: 14px; font-weight: 700; color: var(--ink); }
  .nlead:hover .nl-go { color: var(--brand); }

  /* ── the stack ─────────────────────────────────────────────────────────── */
  .nlist { display: grid; align-content: start; border-top: 1.5px solid var(--rule-3); }
  .nitem button {
    width: 100%; text-align: left; cursor: pointer;
    display: grid; grid-template-columns: 30px minmax(0, 1fr) 20px; align-items: start; gap: 4px 14px;
    padding: 15px 2px; border-bottom: 1px solid var(--rule);
    transition: padding-left .3s cubic-bezier(.2,.8,.25,1), background .22s ease;
  }
  .nitem button:hover { padding-left: 10px; background: linear-gradient(90deg, var(--bg-soft), transparent 72%); }
  .n-i { font-size: 8.5px; letter-spacing: .06em; color: var(--ink-5); padding-top: 4px; }
  .nitem button:hover .n-i { color: var(--brand); }
  .n-body { min-width: 0; }
  .n-meta { display: flex; align-items: center; gap: 9px; }
  .n-d { font-size: 8px; letter-spacing: .09em; color: var(--ink-5); }
  .n-k { font-size: 7.5px; letter-spacing: .09em; color: var(--brand); border: 1px solid rgba(0,144,81,.34); padding: 3px 6px; }
  .n-t {
    display: block; margin-top: 6px; font-size: clamp(14.5px, 0.9vw, 17.5px); font-weight: 700;
    line-height: 1.3; letter-spacing: -0.016em; font-variation-settings: "wdth" 104; color: var(--ink);
  }
  .nitem button:hover .n-t { color: var(--brand); }
  .n-go { color: var(--ink-5); align-self: center; justify-self: end; transition: transform .24s ease, color .24s ease; }
  .nitem button:hover .n-go { color: var(--brand); transform: translateX(3px); }

  /* ── the reader overlay ─────────────────────────────────────────────────── */
  .reader { position: fixed; inset: 0; z-index: 500; display: grid; place-items: center; padding: clamp(10px, 2.4vw, 34px); }
  .r-back { position: absolute; inset: 0; background: rgba(11,15,13,.72); backdrop-filter: blur(3px); animation: fade .2s ease; }
  .r-box { position: relative; width: min(900px, 100%); height: min(92vh, 100%); background: #fff; display: grid; grid-template-rows: auto 1fr; box-shadow: 0 40px 90px -30px rgba(0,0,0,.7); animation: pop .26s cubic-bezier(.2,.8,.25,1); }
  @keyframes fade { from { opacity: 0; } }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(.985); } }
  .r-head { display: flex; align-items: flex-start; gap: 20px; padding: 15px 18px; border-bottom: 1px solid var(--rule); }
  .r-h-t { min-width: 0; }
  .r-h-v { font-size: 8px; letter-spacing: .1em; color: var(--brand); }
  /* The item below already carries the title as its heading; the bar keeps it
     only for the dialog's accessible name. */
  .r-head h2 {
    position: absolute; width: 1px; height: 1px; margin: -1px;
    padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .r-x { width: 34px; height: 34px; margin-left: auto; flex-shrink: 0; border: 1px solid var(--rule-2); font-size: 14px; color: var(--ink-3); }
  .r-x:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .r-body { position: relative; background: var(--bg-soft); }
  .r-body iframe { width: 100%; height: 100%; border: 0; background: #fff; }
  .r-load { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13px; color: var(--ink-4); }
  .r-load span { width: 13px; height: 13px; border: 2px solid var(--rule-2); border-top-color: var(--brand); border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  body.lock { overflow: hidden; }

  /* ── entrance ──────────────────────────────────────────────────────────── */
  .rv { animation: rise .8s cubic-bezier(.19,.86,.28,1) backwards; animation-delay: calc(var(--i) * 90ms + 60ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1180px) {
    .screen-in { grid-template-columns: 1fr; align-content: center; gap: 26px; }
    .right { max-width: 720px; }
  }
  @media (max-width: 900px) {
    .screen { min-height: 0; }
    .aura { inset: -10% 0; filter: blur(52px); }
    .screen-in { padding-top: 34px; padding-bottom: 40px; }
    .stat { padding-right: 22px; margin-right: 22px; }
    .rail-r { width: 100%; }
    .rail-in { align-items: flex-start; }
    .rail-cue { align-items: flex-start; }
    .rail-t { white-space: normal; overflow: visible; }
  }
  @media (prefers-reduced-motion: reduce) { .rv { animation: none; } .aura i { animation: none; } }
</style>

<script>
  // ── news reader: the item opens over the page rather than navigating away
  const nreader = document.getElementById("nreader")!;
  const nframe = document.getElementById("nr-frame") as HTMLIFrameElement;
  const nload = document.getElementById("nr-load")!;
  const ntitle = document.getElementById("nr-title")!;
  let nlast: HTMLElement | null = null;

  function openNews(btn: HTMLElement) {
    nlast = document.activeElement as HTMLElement;
    ntitle.textContent = btn.dataset.title ?? "";
    nload.hidden = false;
    nframe.src = btn.dataset.embed!;
    nreader.hidden = false;
    document.body.classList.add("lock");
    (nreader.querySelector(".r-x") as HTMLElement)?.focus();
  }
  function closeNews() {
    nreader.hidden = true;
    nframe.src = "about:blank";
    document.body.classList.remove("lock");
    nlast?.focus();
  }
  nframe.addEventListener("load", () => {
    if (nframe.src !== "about:blank") nload.hidden = true;
  });
  document.querySelectorAll<HTMLElement>("[data-embed]").forEach((b) =>
    b.addEventListener("click", () => openNews(b))
  );
  nreader.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-close]")) closeNews();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !nreader.hidden) closeNews();
  });

  // Hovering a research area lights its letter in the headline.
  const letters = document.querySelectorAll<HTMLElement>(".hero b");
  document.querySelectorAll<HTMLElement>(".area").forEach((a) => {
    const i = Number(a.dataset.l);
    const on = () => letters[i]?.classList.add("hot");
    const off = () => letters[i]?.classList.remove("hot");
    a.addEventListener("mouseenter", on);
    a.addEventListener("focus", on);
    a.addEventListener("mouseleave", off);
    a.addEventListener("blur", off);
  });
</script>
