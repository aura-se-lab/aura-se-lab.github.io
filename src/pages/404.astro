---
import Base from "@/layouts/Base.astro";
import { ArrowRight } from "@lucide/astro";
---

<Base title="Page not found" noindex>
  <section class="page-hero">
    <div class="shell">
      <p class="caption"><span class="caption-num">404</span> · not found</p>
      <h1 class="h1 mt-2">Page not found</h1>
      <p class="lead mt-3" style="max-width:60ch">If you followed a link from the old site (aura-se-lab.github.io), the page has probably moved. Try one of these:</p>
      <div class="btn-row mt-3">
        <a class="btn" href="/">Home</a>
        <a class="btn" href="/publications/">Publications</a>
        <a class="btn" href="/people/">People</a>
        <a class="btn btn--ghost" href="/news/">News <ArrowRight /></a>
      </div>
    </div>
  </section>
</Base>
<script>
  // legacy al-folio paths → new routes
  const map: Record<string, string> = { "/projects/": "/research/", "/repositories/": "/people/", "/cv/": "/people/antonio-mastropaolo/", "/teaching/": "https://antoniomastropaolo.io/teaching.html" };
  const p = location.pathname.replace(/\/?$/, "/");
  if (map[p]) location.replace(map[p]);
</script>
