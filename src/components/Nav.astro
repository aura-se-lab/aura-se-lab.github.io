---
import { Image } from "astro:assets";
import { lab } from "@/lib/lab";
import mark from "@/assets/brand/aura-mark.png";
import wmLogo from "@/assets/brand/wm-logo.svg?raw";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="bar" id="top" data-open="false">
  <div class="shell bar-in">
    <a href="/" class="brand" aria-label={`${lab.name} — home`} aria-current={path === "/" ? "page" : undefined}>
      <span class="plate"><Image src={mark} alt="" width={132} height={114} loading="eager" /></span>
      <span class="bw">
        <span class="bw-1">AURA<span class="bw-thin">LAB</span></span>
        <span class="bw-2">
          <span class="bw-cs m">CS ·</span>
          <span class="bw-wm" set:html={wmLogo} />
        </span>
      </span>
    </a>

    <nav class="tabs" id="tabs" aria-label="Primary">
      {lab.nav.map((item) => (
        <a
          href={item.href}
          class:list={["tab", { on: isActive(item.href) }]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <span>{item.label}</span>
        </a>
      ))}
      <a class="tab tab-x" href={lab.director.site} target="_blank" rel="noopener"><span>Director ↗</span></a>
    </nav>

    <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="tabs">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .bar {
    position: sticky; top: 0; z-index: 200;
    background: var(--chrome); color: var(--on-chrome);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .bar-in { display: flex; align-items: center; gap: 24px; height: var(--nav-h); }

  /* ── brand ─────────────────────────────────────────────────────────────── */
  .brand { display: flex; align-items: center; gap: 15px; flex-shrink: 0; }
  .plate {
    width: 60px; height: 60px; border-radius: 50%; background: #fff;
    display: grid; place-items: center; flex-shrink: 0;
    transition: transform .3s cubic-bezier(.2,.8,.25,1), box-shadow .3s ease;
  }
  .plate :global(img) { width: 50px; height: auto; }
  .brand:hover .plate { transform: rotate(-6deg) scale(1.05); box-shadow: 0 0 0 4px rgba(0,144,81,.3); }
  .bw { display: flex; flex-direction: column; line-height: 1; gap: 7px; }
  .bw-1 {
    font-variation-settings: "wdth" 118; font-weight: 800; font-size: 21px;
    letter-spacing: -0.014em; color: #fff;
  }
  .bw-thin { font-weight: 400; color: var(--on-chrome-2); margin-left: 3px; }
  .bw-2 { display: flex; align-items: center; gap: 7px; }
  .bw-cs { font-size: 8.5px; letter-spacing: .1em; color: var(--on-chrome-3); }
  .bw-wm { display: inline-block; height: 12px; }
  .bw-wm :global(svg) { height: 12px; width: auto; display: block; }

  /* ── tabs ──────────────────────────────────────────────────────────────── */
  .tabs { margin-left: auto; display: flex; align-items: stretch; height: 100%; }
  .tab {
    position: relative; display: inline-flex; align-items: center; padding: 0 17px;
    font-size: 16px; font-weight: 400; color: rgba(255, 255, 255, 0.78);
    transition: color .18s ease;
  }
  .tab span { position: relative; z-index: 1; }
  .tab::before {
    content: ""; position: absolute; inset: auto 10px 0 10px; height: 2px;
    background: var(--brand); transform: scaleX(0); transform-origin: left;
    transition: transform .28s cubic-bezier(.2,.8,.25,1);
  }
  .tab:hover { color: #fff; }
  .tab:hover::before { transform: scaleX(1); }
  .tab.on { color: #fff; font-weight: 600; }
  .tab.on::before { transform: scaleX(1); height: 3px; }
  .tab-x {
    margin-left: 12px; padding-left: 22px; font-size: 14px; color: var(--on-chrome-3);
    border-left: 1px solid rgba(255,255,255,.14);
  }
  .tab-x::before { display: none; }

  /* ── burger ────────────────────────────────────────────────────────────── */
  .burger { display: none; margin-left: auto; width: 44px; height: 44px; position: relative; }
  .burger span {
    position: absolute; left: 10px; right: 10px; height: 2px; background: #fff;
    transition: transform .28s cubic-bezier(.2,.8,.25,1), opacity .18s ease;
  }
  .burger span:nth-child(1) { top: 15px; }
  .burger span:nth-child(2) { top: 21px; }
  .burger span:nth-child(3) { top: 27px; }
  .bar[data-open="true"] .burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .bar[data-open="true"] .burger span:nth-child(2) { opacity: 0; }
  .bar[data-open="true"] .burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 1060px) {
    .burger { display: block; }
    .tabs {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      background: var(--chrome); flex-direction: column; align-items: stretch; height: auto;
      padding: 6px var(--pad) 20px; border-bottom: 1px solid rgba(255,255,255,.12);
      box-shadow: 0 26px 40px -22px rgba(0,0,0,.7);
    }
    .bar[data-open="true"] .tabs { display: flex; }
    .tab { padding: 15px 0; font-size: 19px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .tab::before { inset: auto auto 10px 0; width: 22px; }
    .tab-x { border-left: 0; padding-left: 0; margin-left: 0; font-size: 14px; border-bottom: 0; }
  }
  @media (max-width: 700px) {
    .plate { width: 48px; height: 48px; }
    .plate :global(img) { width: 40px; }
    .bw-1 { font-size: 18px; }
  }
  @media (max-width: 460px) { .bw-2 { display: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".bar")!;
  const burger = bar.querySelector<HTMLButtonElement>(".burger")!;
  const set = (open: boolean) => {
    bar.dataset.open = String(open);
    burger.setAttribute("aria-expanded", String(open));
  };
  burger.addEventListener("click", () => set(bar.dataset.open !== "true"));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && bar.dataset.open === "true") set(false);
  });
  bar.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
  addEventListener("resize", () => {
    if (innerWidth > 1060 && bar.dataset.open === "true") set(false);
  });
</script>
