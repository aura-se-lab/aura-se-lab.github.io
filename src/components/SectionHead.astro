---
interface Props {
  /** Section index, e.g. "01". The title says what the section is — do not repeat it here. */
  num?: string;
  sub?: string;
  id?: string;
}
const { num, sub, id } = Astro.props;
---

<div class="sec-head" id={id}>
  {num && <div class="sh-label"><span class="sh-num">{num}</span></div>}
  <h2 class="h2 sh-h"><slot /></h2>
  {sub && <p class="lead sh-sub">{sub}</p>}
  {Astro.slots.has("aside") && (
    <div class="sh-aside">
      <slot name="aside" />
    </div>
  )}
</div>
