---
interface Props {
  sub?: string;
  id?: string;
}
const { sub, id } = Astro.props;
---

<div class="sec-head" id={id}>
  <h2 class="h2 sh-h"><slot /></h2>
  {sub && <p class="lead sh-sub">{sub}</p>}
  {Astro.slots.has("aside") && (
    <div class="sh-aside">
      <slot name="aside" />
    </div>
  )}
</div>
