---
/**
 * <head> metadata: title/description/canonical, Open Graph + Twitter cards,
 * JSON-LD, feeds, and (for papers) the Google Scholar `citation_*` tags.
 */
import { lab } from "@/lib/lab";

interface Props {
  title?: string;
  description?: string;
  /** Path of the OG image (defaults to the site-wide card) */
  image?: string;
  type?: "website" | "article" | "profile";
  /** Extra <meta name=...> pairs, e.g. Google Scholar citation_* tags */
  meta?: { name: string; content: string }[];
  /** One or more JSON-LD objects */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
}

const { title, description = lab.tagline, image = "/og/site.png", type = "website", meta = [], jsonLd, noindex = false, publishedTime } = Astro.props;

const site = Astro.site ?? new URL("https://auralab.sh");
const canonical = new URL(Astro.url.pathname, site);
const fullTitle = title ? `${title} · ${lab.short_name}` : `${lab.name} — ${lab.acronym.expansion}`;
const ogImage = new URL(image, site);

const org = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  "@id": `${site.origin}/#org`,
  name: lab.name,
  alternateName: [lab.short_name, "AURA Lab", lab.acronym.expansion],
  url: site.origin + "/",
  logo: `${site.origin}/img/aura-glyph.svg`,
  email: lab.contact.email,
  foundingDate: lab.founded,
  parentOrganization: { "@type": "CollegeOrUniversity", name: lab.institution.name, url: "https://www.wm.edu" },
  department: { "@type": "Organization", name: lab.institution.department, url: lab.institution.url },
  address: {
    "@type": "PostalAddress",
    streetAddress: `${lab.institution.address.building}, ${lab.institution.address.street}`,
    addressLocality: lab.institution.address.city,
    addressRegion: lab.institution.address.region,
    postalCode: lab.institution.address.postal,
    addressCountry: "US",
  },
  founder: { "@type": "Person", "@id": `${site.origin}/people/${lab.director.slug}/#person`, name: lab.director.name, url: lab.director.site },
  sameAs: Object.values(lab.social),
};
const ld = [org, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#050505" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${lab.short_name} — News`} href="/rss.xml" />
<link rel="alternate" type="application/rss+xml" title={`${lab.short_name} — Publications`} href="/publications.xml" />
<meta name="generator" content={Astro.generator} />

<meta property="og:site_name" content={lab.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? lab.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? lab.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />
{lab.social.x && <meta name="twitter:site" content={"@" + lab.social.x.split("/").pop()} />}

{meta.map((m) => <meta name={m.name} content={m.content} />)}

<script type="application/ld+json" set:html={JSON.stringify(ld)} />
