---
import { Image } from "astro:assets";
import { lab } from "@/lib/lab";
import { metrics } from "@/lib/pubs";
import { fmtDate } from "@/lib/dates";
import lockup from "@/assets/brand/aura-lockup.png";

const year = new Date().getFullYear();
const updated = fmtDate(metrics.updated);
const a = lab.institution.address;
---

<footer class="coda">
  <div class="shell">
    <div class="coda-top">
      <div class="c-id">
        <span class="c-plate"><Image src={lockup} alt={lab.name} width={420} height={130} loading="eager" /></span>
        <p class="c-addr">
          {lab.institution.department} · {lab.institution.name}<br />
          {a.building}, {a.street}, {a.city}, {a.region} {a.postal}
        </p>
      </div>

      <nav class="c-cols" aria-label="Footer">
        <div class="c-col">
          <h4 class="m">PAGES</h4>
          {lab.nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        <div class="c-col">
          <h4 class="m">CONTACT</h4>
          <a href={`mailto:${lab.contact.email}`}>{lab.contact.email}</a>
          {lab.social.github && <a href={lab.social.github} target="_blank" rel="noopener">GitHub</a>}
          {lab.social.x && <a href={lab.social.x} target="_blank" rel="noopener">X</a>}
          {lab.social.scholar && <a href={lab.social.scholar} target="_blank" rel="noopener">Scholar</a>}
        </div>
        <div class="c-col">
          <h4 class="m">DATA</h4>
          <a href="/aura.bib">BibTeX, all papers</a>
          <a href="/publications.xml">Publications feed</a>
          <a href="/rss.xml">News feed</a>
        </div>
      </nav>
    </div>

    <div class="c-bot">
      <span>© {year} {lab.name}, {lab.institution.name}.</span>
      <span class="c-sync m"><i aria-hidden="true"></i>PUBLICATIONS SYNCED {updated.toUpperCase()}</span>
    </div>
  </div>
</footer>

<style>
  .coda {
    background: var(--chrome); color: var(--on-chrome-2);
    padding: clamp(34px, 4vw, 52px) 0 22px; font-size: 13.5px; line-height: 1.55;
  }
  .coda-top {
    display: flex; flex-wrap: wrap; gap: 34px 60px; justify-content: space-between;
    padding-bottom: 26px; border-bottom: 1px solid rgba(255,255,255,.12);
  }
  .c-plate { display: inline-block; background: #fff; padding: 12px 16px; }
  .c-plate :global(img) { width: 210px; height: auto; }
  .c-addr { margin-top: 14px; font-size: 12.5px; color: var(--on-chrome-3); line-height: 1.6; }

  .c-cols { display: flex; flex-wrap: wrap; gap: 26px 56px; }
  .c-col { display: flex; flex-direction: column; gap: 6px; min-width: 130px; }
  .c-col h4 { font-size: 8px; letter-spacing: .12em; color: var(--brand); margin-bottom: 5px; font-weight: 600; }
  .c-col a { color: var(--on-chrome-2); width: fit-content; border-bottom: 1px solid transparent; }
  .c-col a:hover { color: #fff; border-color: var(--brand); }

  .c-bot {
    margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px 24px;
    justify-content: space-between; font-size: 12px; color: var(--on-chrome-3);
  }
  .c-sync { font-size: 8px; letter-spacing: .1em; display: inline-flex; align-items: center; }
  .c-sync i { width: 5px; height: 5px; border-radius: 50%; background: var(--brand); margin-right: 8px; }
  @media (max-width: 700px) { .c-cols { gap: 22px 40px; } .c-plate :global(img) { width: 170px; } }
</style>
