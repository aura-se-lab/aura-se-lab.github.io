---
/** STUDY 10 — Orbit. The four avenues sit on a ring and every paper in the
 *  record orbits the direction it belongs to. Papers that span two are pulled
 *  between them, so the overlaps in the corpus are visible as motion rather
 *  than described in a sentence. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { publications, isReviewed, venueLabel } from "@/lib/pubs";

const dirs = await directions();
const idx = new Map(dirs.map((d, i) => [d.id, i]));
/** Every paper, with the directions it belongs to, as indices into the ring. */
const nodes = publications
  .filter((p) => (p.threads ?? []).some((t) => idx.has(t)))
  .map((p) => ({
    k: p.key,
    t: p.title,
    v: `${venueLabel(p)} ${p.year}`,
    r: isReviewed(p),
    a: (p.threads ?? []).map((t) => idx.get(t)).filter((n): n is number => n !== undefined),
  }));
---

<Base title="Research — study 10" description="Design study" noindex>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <p class="label">FOUR AVENUES · {nodes.length} PAPERS IN ORBIT</p>
        <h1 class="h2 mt-2">Research</h1>
        <p class="lead mt-2" style="max-width:62ch">{lab.brief[0]}</p>
      </header>

      <div class="orb">
        <div class="o-stage">
          <canvas id="sky" aria-hidden="true"></canvas>
          <div class="o-hud" id="hud" hidden>
            <span class="m o-hv"></span>
            <span class="o-ht"></span>
          </div>
        </div>

        <ol class="o-legend" id="legend">
          {dirs.map((d, i) => (
            <li class="o-row" style={`--c:var(--a${i + 1})`} data-i={String(i)}>
              <button type="button">
                <span class="o-dot" aria-hidden="true"></span>
                <span class="o-body">
                  <span class="o-t">{d.title}</span>
                  <span class="o-q">{d.q}</span>
                  <span class="m o-n">{d.papers.length} papers · {d.reviewed.length} peer-reviewed · {d.span}</span>
                </span>
              </button>
              <div class="o-open">
                <p class="o-a">{d.a}</p>
                <a class="o-go" href={`/research/${d.id}/`}>Open the direction →</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ nodes }}>window.__ORBIT__ = nodes;</script>
</Base>

<style>
  .orb { display: grid; gap: 30px; margin-top: 8px; }
  @media (min-width: 1040px) { .orb { grid-template-columns: minmax(0, 1fr) minmax(360px, 430px); gap: 46px; align-items: start; } }

  .o-stage { position: relative; aspect-ratio: 1 / 0.66; border: 1px solid var(--rule); background: var(--bg-soft); overflow: hidden; }
  #sky { position: absolute; inset: 0; width: 100%; height: 100%; }
  .o-hud {
    position: absolute; left: 14px; bottom: 14px; right: 14px; pointer-events: none;
    background: rgba(255,255,255,.94); border: 1px solid var(--rule-2); padding: 9px 12px;
  }
  .o-hv { display: block; font-size: 7.5px; letter-spacing: .1em; color: var(--ink-5); }
  .o-ht { display: block; margin-top: 3px; font-size: 13px; font-weight: 700; line-height: 1.3; }

  .o-legend { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--rule-3); }
  .o-row { border-bottom: 1px solid var(--rule); }
  .o-row > button { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 13px; width: 100%; padding: 15px 4px; text-align: left; align-items: start; }
  .o-row:hover > button, .o-row.on > button { background: var(--bg-soft); }
  .o-dot { width: 10px; height: 10px; margin-top: 5px; border-radius: 50%; background: var(--c); opacity: .35; transition: opacity .25s ease, transform .25s ease; }
  .o-row:hover .o-dot, .o-row.on .o-dot { opacity: 1; transform: scale(1.35); }
  .o-t { display: block; font-size: 14.5px; font-weight: 700; letter-spacing: -0.014em; }
  .o-row:hover .o-t, .o-row.on .o-t { color: var(--c); }
  .o-q { display: block; margin-top: 4px; font-size: 13px; line-height: 1.45; color: var(--ink-4); }
  .o-n { display: block; margin-top: 6px; font-size: 7.5px; letter-spacing: .09em; color: var(--ink-5); }

  .o-open { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .4s cubic-bezier(.2,.8,.25,1), opacity .28s ease; }
  .o-row.on .o-open { max-height: 260px; opacity: 1; }
  .o-a { padding: 0 4px 4px 27px; font-size: 13px; line-height: 1.6; color: var(--ink-3); }
  .o-go { display: inline-block; margin: 8px 0 16px 27px; font-size: 12.5px; font-weight: 700; color: var(--c); }
</style>

<script>
  const cv = document.getElementById("sky") as HTMLCanvasElement | null;
  if (cv) {
    type N = { k: string; t: string; v: string; r: boolean; a: number[] };
    const data = ((window as any).__ORBIT__ ?? []) as N[];
    const ctx = cv.getContext("2d")!;
    const cs = getComputedStyle(document.documentElement);
    const col = [1, 2, 3, 4].map((n) => cs.getPropertyValue(`--a${n}`).trim() || "#009051");
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const hud = document.getElementById("hud")!;
    const hudV = hud.querySelector(".o-hv")!;
    const hudT = hud.querySelector(".o-ht")!;
    const rows = [...document.querySelectorAll<HTMLElement>(".o-row")];

    let w = 0, h = 0, t = 0, focus = -1, mx = -1, my = -1;
    const fit = () => {
      const r = cv.getBoundingClientRect();
      const d = Math.min(devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      cv.width = Math.max(1, w * d); cv.height = Math.max(1, h * d);
      ctx.setTransform(d, 0, 0, d, 0, 0);
    };
    fit();
    new ResizeObserver(fit).observe(cv);

    /* Each paper carries its own phase and radius so the field never reads as
       a clock face; a two-direction paper hangs between its anchors. */
    const P = data.map((n, i) => ({
      n,
      ph: (i * 2.399) % (Math.PI * 2),
      sp: 0.16 + ((i * 7919) % 100) / 900,
      rr: 0.42 + ((i * 104729) % 100) / 420,
      x: 0, y: 0, rad: 0,
    }));

    const anchors = () => {
      const cx = w / 2, cy = h / 2, R = Math.min(w * 0.42, h * 0.40);
      return col.map((_, i) => {
        const a = -Math.PI / 2 + (i * Math.PI) / 2;
        return { x: cx + Math.cos(a) * R, y: cy + Math.sin(a) * R };
      });
    };

    let visible = true;
    new IntersectionObserver(([x]) => { visible = x.isIntersecting; }, { threshold: 0 }).observe(cv);

    function frame(ms: number) {
      requestAnimationFrame(frame);
      if (!visible) return;
      if (!still) t = ms;
      ctx.clearRect(0, 0, w, h);
      const A = anchors();

      // the ring the avenues sit on
      ctx.strokeStyle = "rgba(17,24,20,.07)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, Math.min(w * 0.42, h * 0.40), 0, Math.PI * 2);
      ctx.stroke();

      let hit: { n: N; d: number } | null = null;
      for (const p of P) {
        // home is the mean of the paper's directions: a shared paper floats between
        let hx = 0, hy = 0;
        for (const a of p.n.a) { hx += A[a].x; hy += A[a].y; }
        hx /= p.n.a.length; hy /= p.n.a.length;

        const pull = focus >= 0 && p.n.a.includes(focus) ? 0.55 : 1;
        const r = Math.min(w, h) * 0.155 * p.rr * pull;
        const ang = p.ph + (t * 0.00016) * p.sp * (p.n.a.length > 1 ? -1 : 1);
        p.x = hx + Math.cos(ang) * r;
        p.y = hy + Math.sin(ang) * r * 0.72;
        p.rad = p.n.r ? 3.6 : 2.6;

        if (mx >= 0) {
          const d = Math.hypot(p.x - mx, p.y - my);
          if (d < 13 && (!hit || d < hit.d)) hit = { n: p.n, d };
        }

        // a shared paper draws its two allegiances
        if (p.n.a.length > 1) {
          ctx.strokeStyle = "rgba(17,24,20,.10)";
          for (const a of p.n.a) {
            ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(A[a].x, A[a].y); ctx.stroke();
          }
        }

        const dim = focus >= 0 && !p.n.a.includes(focus);
        ctx.globalAlpha = dim ? 0.12 : p.n.r ? 0.9 : 0.45;
        ctx.fillStyle = col[p.n.a[0]];
        ctx.beginPath(); ctx.arc(p.x, p.y, p.rad, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
      }

      A.forEach((a, i) => {
        const on = focus === i;
        ctx.globalAlpha = focus >= 0 && !on ? 0.25 : 1;
        ctx.fillStyle = col[i];
        ctx.beginPath(); ctx.arc(a.x, a.y, on ? 9 : 6.5, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = focus >= 0 && !on ? 0.1 : 0.16;
        ctx.beginPath(); ctx.arc(a.x, a.y, on ? 26 : 18, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
      });

      if (hit) { hud.hidden = false; hudV.textContent = hit.n.v.toUpperCase(); hudT.textContent = hit.n.t; }
      else if (mx < 0) hud.hidden = true;
    }
    requestAnimationFrame(frame);

    cv.addEventListener("pointermove", (e) => {
      const r = cv.getBoundingClientRect();
      mx = e.clientX - r.left; my = e.clientY - r.top;
    });
    cv.addEventListener("pointerleave", () => { mx = -1; my = -1; hud.hidden = true; });

    rows.forEach((row, i) => {
      const set = (v: number) => { focus = v; rows.forEach((r, j) => r.classList.toggle("on", j === v)); };
      row.addEventListener("mouseenter", () => set(i));
      row.querySelector("button")!.addEventListener("click", () => set(focus === i ? -1 : i));
    });
    document.getElementById("legend")!.addEventListener("mouseleave", () => {
      if (!rows.some((r) => r.classList.contains("on"))) focus = -1;
    });
  }
</script>
