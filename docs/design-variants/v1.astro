---
/** STUDY 1 — Evidence bands. Each direction is a full-width band that ends in
 *  the papers that back it: the page argues, then shows its working. */
import type { ImageMetadata } from "astro";
import Base from "@/layouts/Base.astro";
import Cover from "@/components/Cover.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { venueLabel, shortName } from "@/lib/pubs";

const dirs = await directions();
const covers = import.meta.glob<{ default: ImageMetadata }>("../../assets/papers/*.jpg", { eager: true });
const coverOf = (k: string) => covers[`../../assets/papers/${k}.jpg`]?.default;
---

<Base title="Research — study 1" description="Design study" noindex>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <div class="row">
          <div>
            <p class="label">{dirs.length} DIRECTIONS · {dirs.reduce((n, d) => n + d.papers.length, 0)} PAPERS</p>
            <h1 class="h2 mt-2">Research</h1>
          </div>
        </div>
        <p class="lead" style="max-width:62ch">{lab.brief[0]}</p>
      </header>
    </div>

    {dirs.map((d, i) => (
      <section class="band" style={`--c:var(--a${i + 1})`}>
        <div class="shell">
          <div class="b-top">
            <span class="b-l exp">{d.letter}</span>
            <div class="b-h">
              <p class="m b-n">DIRECTION {String(i + 1).padStart(2, "0")} / {String(dirs.length).padStart(2, "0")}</p>
              <h2 class="b-t">{d.title}</h2>
              <p class="b-s">{d.short}</p>
            </div>
            <dl class="b-f">
              <div><dt class="m">PAPERS</dt><dd class="num">{d.papers.length}</dd></div>
              <div><dt class="m">PEER-REVIEWED</dt><dd class="num">{d.reviewed.length}</dd></div>
              <div><dt class="m">SPAN</dt><dd class="num">{d.span}</dd></div>
            </dl>
          </div>

          <p class="b-v m">{d.venues.join(" · ")}</p>

          <ul class="b-work">
            {d.papers.slice(0, 5).map((p) => (
              <li>
                <a href={`/publications/${p.key}/`}>
                  <span class="w-cov"><Cover pub={p} cover={coverOf(p.key)} widths={[150, 300]} sizes="98px" /></span>
                  <span class="w-b">
                    <span class="m w-v">{venueLabel(p)} · {p.year}</span>
                    <span class="w-t">{p.title}</span>
                    <span class="w-a">{p.authors.map((a) => shortName(a.name)).join(", ")}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <a class="b-go" href={`/research/${d.id}/`}>All {d.papers.length} papers in this direction →</a>
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .band { padding: clamp(34px, 4vw, 60px) 0; border-top: 1px solid var(--rule); }
  .band:first-of-type { border-top: 1.5px solid var(--rule-3); }
  .b-top { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 20px 24px; align-items: start; }
  @media (min-width: 1000px) { .b-top { grid-template-columns: 64px minmax(0, 1fr) 210px; gap: 34px; } }
  .b-l { font-size: 58px; font-weight: 800; line-height: .8; color: var(--c); font-variation-settings: "wdth" 118; }
  .b-n { font-size: 8px; letter-spacing: .12em; color: var(--ink-5); }
  .b-t { margin-top: 8px; font-size: clamp(22px, 2.3vw, 31px); font-weight: 800; letter-spacing: -0.026em; line-height: 1.12; }
  .b-s { margin-top: 10px; max-width: 68ch; font-size: 15.5px; line-height: 1.62; color: var(--ink-3); }
  .b-f { margin: 0; display: grid; grid-template-columns: repeat(3, auto); gap: 6px 22px; grid-column: 1 / -1; }
  @media (min-width: 1000px) { .b-f { grid-template-columns: 1fr; grid-column: auto; gap: 12px; } }
  .b-f dt { font-size: 8px; letter-spacing: .1em; color: var(--ink-5); }
  .b-f dd { margin: 2px 0 0; font-size: 21px; font-weight: 300; letter-spacing: -0.02em; }
  .b-v { margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--rule); font-size: 8.5px; letter-spacing: .1em; color: var(--c); }

  .b-work { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .b-work a { display: block; }
  .w-cov { display: block; width: 100%; aspect-ratio: 17/22; container-type: inline-size; background: var(--bg-soft); border: 1px solid var(--rule); overflow: hidden; transition: border-color .2s, transform .2s; }
  .b-work a:hover .w-cov { border-color: var(--c); transform: translateY(-3px); }
  .w-cov :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .w-v { display: block; margin-top: 9px; font-size: 8px; letter-spacing: .09em; color: var(--ink-5); }
  .w-t { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4px; font-size: 13px; font-weight: 700; line-height: 1.3; }
  .b-work a:hover .w-t { color: var(--c); }
  .w-a { display: block; margin-top: 4px; font-size: 11.5px; color: var(--ink-5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .b-go { display: inline-block; margin-top: 22px; font-size: 13.5px; font-weight: 700; border-bottom: 1px solid var(--rule-2); }
  .b-go:hover { color: var(--c); border-color: var(--c); }
</style>
