---
/** STUDY 6 — Doors. Four panels that hold the full height of the screen and
 *  open under the cursor. Each carries a live motif drawn from what the
 *  direction actually does. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { venueLabel } from "@/lib/pubs";

const dirs = await directions();
const motif = ["quantize", "parse", "measure", "flow"];
---

<Base title="Research — study 6" description="Design study" noindex class="v6">
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <div class="row">
          <div>
            <p class="label">FOUR AVENUES</p>
            <h1 class="h2 mt-2">Research</h1>
          </div>
        </div>
        <p class="lead" style="max-width:60ch">{lab.brief[0]}</p>
      </header>
    </div>

    <div class="doors" id="doors">
      {dirs.map((d, i) => (
        <article class:list={["door", { open: i === 0 }]} data-i={String(i)} style={`--c:var(--a${i + 1})`} tabindex="0">
          <canvas class="d-cv" data-motif={motif[i]} aria-hidden="true"></canvas>
          <div class="d-rail">
            <span class="d-n m">{String(i + 1).padStart(2, "0")}</span>
            <h2 class="d-spine">{d.title}</h2>
            <span class="d-c m">{d.papers.length}</span>
          </div>
          <div class="d-body">
            <p class="m d-k">{d.venues.slice(0, 5).join(" · ")}</p>
            <h3 class="d-t">{d.title}</h3>
            <p class="d-q">{d.q}</p>
            <p class="d-s">{d.a}</p>
            <ul class="d-work">
              {d.papers.slice(0, 3).map((p) => (
                <li><a href={`/publications/${p.key}/`}><span class="m">{venueLabel(p)} {p.year}</span>{p.title}</a></li>
              ))}
            </ul>
            <a class="d-go" href={`/research/${d.id}/`}>{d.papers.length} papers →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .doors { display: grid; gap: 2px; margin-top: 6px; padding: 0 clamp(16px, 4vw, 48px); }
  .door {
    position: relative; overflow: hidden; background: var(--bg-soft);
    border: 1px solid var(--rule); min-height: 96px; cursor: pointer;
    transition: background .35s ease, border-color .35s ease;
  }
  .door:hover, .door:focus-visible { border-color: var(--c); outline: none; }
  .d-cv { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .55; transition: opacity .4s ease; }
  .door.open .d-cv { opacity: 1; }
  /* The motif is a backdrop; the words stay on white. */
  .door::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, var(--bg) 8%, rgba(255,255,255,.82) 52%, rgba(255,255,255,.15) 100%);
  }

  .d-rail { position: relative; z-index: 1; display: flex; align-items: center; gap: 16px; padding: 0 20px; height: 96px; }
  .d-n { font-size: 9px; letter-spacing: .12em; color: var(--c); }
  .d-spine { font-size: clamp(17px, 2vw, 24px); font-weight: 800; letter-spacing: -0.026em; line-height: 1.1; }
  .d-c { margin-left: auto; font-size: 9px; color: var(--ink-5); }

  .d-body { position: relative; z-index: 1; max-height: 0; opacity: 0; overflow: hidden; padding: 0 20px; transition: max-height .5s cubic-bezier(.2,.8,.25,1), opacity .35s ease, padding .5s ease; }
  .door.open .d-body { max-height: 560px; opacity: 1; padding: 0 20px 26px; }
  .d-k { font-size: 8px; letter-spacing: .1em; color: var(--c); }
  .d-t { display: none; }
  .d-q { margin-top: 10px; max-width: 34ch; font-size: clamp(19px, 2.3vw, 30px); font-weight: 300; letter-spacing: -0.028em; line-height: 1.16; }
  .d-s { margin-top: 12px; max-width: 62ch; font-size: 14.5px; line-height: 1.65; color: var(--ink-3); }
  .d-work { list-style: none; margin: 18px 0 0; padding: 0; max-width: 70ch; border-top: 1px solid var(--rule); }
  .d-work a { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: 13.5px; font-weight: 600; }
  .d-work .m { font-size: 8px; letter-spacing: .09em; color: var(--ink-5); }
  .d-work a:hover { color: var(--c); }
  .d-go { display: inline-block; margin-top: 16px; font-size: 13px; font-weight: 700; border-bottom: 1px solid var(--c); color: var(--c); }

  /* On a wide screen the doors stand side by side and open horizontally. */
  @media (min-width: 1000px) {
    .doors { grid-auto-flow: column; grid-auto-columns: 1fr; height: min(72vh, 660px); }
    .door { min-height: 0; transition: flex .5s cubic-bezier(.2,.8,.25,1); }
    .doors { display: flex; }
    .door { flex: 1 1 0; min-width: 0; }
    .door.open { flex: 3.4 1 0; }
    .d-rail { height: auto; position: absolute; inset: 0; flex-direction: column; align-items: flex-start; justify-content: space-between; padding: 22px 18px; }
    .d-spine { writing-mode: vertical-rl; transform: rotate(180deg); margin: 14px 0; font-size: 19px; max-height: 62%; overflow: hidden; }
    .d-c { margin-left: 0; }
    .door.open .d-rail { opacity: 0; pointer-events: none; transition: opacity .2s ease; }
    .d-body { position: absolute; inset: 0; max-height: none; padding: 30px 32px; display: flex; flex-direction: column; justify-content: flex-end; overflow: auto; }
    .door.open .d-body { padding: 30px 32px; }
    .d-t { display: block; margin-top: 8px; font-size: 15px; font-weight: 700; color: var(--c); }
    .d-q { margin-top: 14px; }
  }
</style>

<script>
  import { mountMotif, type Motif } from "@/scripts/motifs";

  const hues = ["--a1", "--a2", "--a3", "--a4"];
  const doors = [...document.querySelectorAll<HTMLElement>(".door")];
  const cs = getComputedStyle(document.documentElement);

  const ctls = doors.map((d, i) => {
    const cv = d.querySelector("canvas") as HTMLCanvasElement;
    const c = cs.getPropertyValue(hues[i]).trim() || "#009051";
    return mountMotif(cv, cv.dataset.motif as Motif, c);
  });

  const open = (i: number) => {
    doors.forEach((d, j) => {
      d.classList.toggle("open", j === i);
      ctls[j].energy(j === i ? 1 : 0.25);
    });
  };
  open(0);
  doors.forEach((d, i) => {
    d.addEventListener("mouseenter", () => open(i));
    d.addEventListener("focus", () => open(i));
    d.addEventListener("click", () => open(i));
  });
</script>
