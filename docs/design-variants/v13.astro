---
/** STUDY 13 — Thread. One line runs the length of the page and the four
 *  avenues hang off it. The line draws itself as you scroll and thickens
 *  where the record is thickest, so the page has a spine you can follow. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { venueLabel } from "@/lib/pubs";

const dirs = await directions();
const max = Math.max(...dirs.map((d) => d.papers.length));
---

<Base title="Research — study 13" description="Design study" noindex>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <p class="label">FOUR AVENUES · ONE THREAD</p>
        <h1 class="h2 mt-2">Research</h1>
        <p class="lead mt-2" style="max-width:62ch">{lab.brief[0]}</p>
      </header>

      <div class="th">
        <div class="th-rail" aria-hidden="true">
          <svg viewBox="0 0 100 1000" preserveAspectRatio="none">
            <path id="spine" class="sp-ghost" d="M50 0 C 4 150, 96 300, 50 470 S 4 760, 50 1000" />
            <path class="sp-live" d="M50 0 C 4 150, 96 300, 50 470 S 4 760, 50 1000" />
          </svg>
        </div>

        <ol class="th-list">
          {dirs.map((d, i) => (
            <li class="st" style={`--c:var(--a${i + 1}); --w:${(d.papers.length / max) * 100}%`}>
              <span class="st-knot" aria-hidden="true"></span>
              <div class="st-in">
                <p class="m st-n">{String(i + 1).padStart(2, "0")} · {d.span}</p>
                <h2 class="st-q">{d.q}</h2>
                <p class="st-t">{d.title}</p>
                <p class="st-a">{d.a}</p>

                <div class="st-bar" aria-hidden="true"><span></span></div>
                <p class="m st-c">{d.papers.length} papers · {d.reviewed.length} peer-reviewed · {d.venues.slice(0, 5).join(" · ")}</p>

                <ul class="st-work">
                  {d.papers.slice(0, 4).map((p) => (
                    <li><a href={`/publications/${p.key}/`}><span class="m">{venueLabel(p)} {p.year}</span><span>{p.title}</span></a></li>
                  ))}
                </ul>
                <a class="st-go" href={`/research/${d.id}/`}>Open the direction →</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Base>

<style>
  .th { position: relative; margin-top: 10px; }
  .th-rail { position: absolute; inset: 0 auto 0 0; width: 120px; pointer-events: none; }
  @media (max-width: 860px) { .th-rail { display: none; } }
  .th-rail svg { width: 100%; height: 100%; }
  .sp-ghost { fill: none; stroke: var(--rule); stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  /* The live stroke is revealed by scroll rather than animated on a timer, so
     the drawing tracks the reader instead of racing them. */
  .sp-live {
    fill: none; stroke: var(--brand); stroke-width: 2.2; vector-effect: non-scaling-stroke;
    stroke-dasharray: var(--len, 2200); stroke-dashoffset: calc(var(--len, 2200) * (1 - var(--p, 0)));
  }

  .th-list { list-style: none; margin: 0; padding: 0; }
  .st { position: relative; padding: clamp(34px, 4.4vw, 64px) 0; }
  @media (min-width: 861px) { .st { padding-left: 160px; } }
  .st + .st { border-top: 1px solid var(--rule); }

  .st-knot {
    position: absolute; left: 54px; top: clamp(40px, 4.6vw, 70px); width: 13px; height: 13px;
    border-radius: 50%; background: var(--bg); border: 2px solid var(--c);
    transform: scale(.6); opacity: .4; transition: transform .5s cubic-bezier(.2,.8,.25,1), opacity .4s ease;
  }
  @media (max-width: 860px) { .st-knot { display: none; } }
  .st.lit .st-knot { transform: scale(1); opacity: 1; box-shadow: 0 0 0 6px color-mix(in srgb, var(--c) 14%, transparent); }

  .st-in { opacity: 0; transform: translateY(14px); transition: opacity .55s ease, transform .55s cubic-bezier(.2,.8,.25,1); }
  .st.lit .st-in { opacity: 1; transform: none; }
  .st-n { font-size: 8px; letter-spacing: .12em; color: var(--ink-5); }
  .st-q { margin-top: 12px; max-width: 24ch; font-size: clamp(26px, 3.4vw, 46px); font-weight: 300; line-height: 1.08; letter-spacing: -0.035em; }
  .st-t { margin-top: 14px; font-size: 14px; font-weight: 700; color: var(--c); }
  .st-a { margin-top: 12px; max-width: 62ch; font-size: 14.5px; line-height: 1.68; color: var(--ink-3); }

  /* Weight of the record, drawn to scale against the largest direction. */
  .st-bar { margin-top: 22px; height: 3px; background: var(--rule); max-width: 420px; }
  .st-bar span { display: block; height: 100%; width: 0; background: var(--c); transition: width .9s cubic-bezier(.2,.8,.25,1) .1s; }
  .st.lit .st-bar span { width: var(--w); }
  .st-c { margin-top: 9px; font-size: 8px; letter-spacing: .09em; color: var(--ink-5); }

  .st-work { list-style: none; margin: 20px 0 0; padding: 0; border-top: 1px solid var(--rule); max-width: 720px; }
  .st-work a { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--rule); font-size: 13px; font-weight: 600; }
  .st-work .m { font-size: 7.5px; letter-spacing: .09em; color: var(--ink-5); }
  .st-work a:hover { color: var(--c); }
  .st-go { display: inline-block; margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--c); }

  @media (prefers-reduced-motion: reduce) {
    .st-in { opacity: 1; transform: none; }
    .st-knot { transform: scale(1); opacity: 1; }
    .st-bar span { width: var(--w); transition: none; }
    .sp-live { stroke-dashoffset: 0; }
  }
</style>

<script>
  const live = document.querySelector<SVGPathElement>(".sp-live");
  const rail = document.querySelector<HTMLElement>(".th");
  if (live && rail) {
    const len = live.getTotalLength();
    live.style.setProperty("--len", String(len));
    const onScroll = () => {
      const r = rail.getBoundingClientRect();
      const p = (window.innerHeight * 0.62 - r.top) / r.height;
      live.style.setProperty("--p", String(Math.max(0, Math.min(1, p))));
    };
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
  }

  const io = new IntersectionObserver(
    (es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("lit")),
    { threshold: 0.2 }
  );
  document.querySelectorAll(".st").forEach((s) => io.observe(s));
</script>
