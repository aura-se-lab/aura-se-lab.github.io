---
/** STUDY 7 — Field. Every paper is a point, placed by the directions it
 *  belongs to. Papers that span two directions sit between them, so the
 *  overlap in the record becomes the picture. */
import Base from "@/layouts/Base.astro";
import { directions } from "@/lib/research";
import { lab } from "@/lib/lab";
import { publications, isReviewed, venueLabel } from "@/lib/pubs";

const dirs = await directions();
const pts = publications
  .filter((p) => p.threads?.length)
  .map((p) => ({
    k: p.key,
    t: p.title,
    y: p.year,
    v: venueLabel(p),
    r: isReviewed(p),
    d: (p.threads ?? []).map((id) => dirs.findIndex((x) => x.id === id)).filter((i) => i >= 0),
  }));
---

<Base title="Research — study 7" description="Design study" noindex>
  <div class="page">
    <div class="shell">
      <header class="page-head">
        <div class="row">
          <div>
            <p class="label">{pts.length} PAPERS ACROSS FOUR AVENUES</p>
            <h1 class="h2 mt-2">Research</h1>
          </div>
        </div>
        <p class="lead" style="max-width:60ch">{lab.brief[0]}</p>
      </header>

      <div class="field">
        <canvas id="fld" aria-hidden="true"></canvas>
        <div class="tip" id="tip" hidden></div>
      </div>
      <div class="f-legend">
          {dirs.map((d, i) => (
            <button class="lg" data-i={String(i)} style={`--c:var(--a${i + 1})`}>
              <span class="lg-d"></span>
              <span class="lg-t">{d.title.split(/[&—]/)[0].trim()}</span>
              <span class="m lg-n">{d.papers.length}</span>
            </button>
          ))}
      </div>
      <p class="f-cap m">EACH POINT IS A PAPER · A POINT BETWEEN TWO CLUSTERS BELONGS TO BOTH · HOVER TO READ IT</p>

      <div class="cards">
        {dirs.map((d, i) => (
          <article class="c" data-i={String(i)} style={`--c:var(--a${i + 1})`}>
            <p class="m c-n">AVENUE {String(i + 1).padStart(2, "0")} · {d.span}</p>
            <h2 class="c-t">{d.title}</h2>
            <p class="c-q">{d.q}</p>
            <p class="c-s">{d.a}</p>
            <a class="c-go" href={`/research/${d.id}/`}>{d.papers.length} papers →</a>
          </article>
        ))}
      </div>
    </div>
  </div>

  <script is:inline set:html={`window.__PTS = ${JSON.stringify(pts)};`} />
</Base>

<style>
  .field { position: relative; margin-top: 4px; border: 1px solid var(--rule); background: var(--bg-soft); }
  #fld { display: block; width: 100%; height: clamp(360px, 52vh, 560px); }
  .f-legend { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .lg { display: flex; align-items: center; gap: 9px; padding: 7px 12px 7px 9px; background: var(--bg); border: 1px solid var(--rule-2); }
  .lg:hover, .lg.on { border-color: var(--c); }
  .lg-d { width: 9px; height: 9px; border-radius: 50%; background: var(--c); }
  .lg-t { font-size: 12px; font-weight: 600; color: var(--ink-2); }
  .lg-n { font-size: 8px; color: var(--ink-5); }
  .f-cap { margin-top: 9px; font-size: 8px; letter-spacing: .1em; color: var(--ink-5); }

  .tip { position: absolute; z-index: 3; max-width: 300px; padding: 10px 12px; background: var(--chrome); color: #fff; pointer-events: none; }
  .tip b { display: block; font-size: 13px; font-weight: 700; line-height: 1.32; }
  .tip span { display: block; margin-top: 5px; font-family: var(--mono); font-size: 8px; letter-spacing: .09em; color: rgba(255,255,255,.6); }

  .cards { display: grid; gap: 14px; margin-top: clamp(26px, 3vw, 40px); }
  @media (min-width: 860px) { .cards { grid-template-columns: repeat(2, 1fr); gap: 18px; } }
  @media (min-width: 1280px) { .cards { grid-template-columns: repeat(4, 1fr); } }
  .c { padding: 18px; border: 1px solid var(--rule); border-top: 3px solid var(--c); transition: transform .25s ease, box-shadow .25s ease; }
  .c.hot { transform: translateY(-4px); box-shadow: 0 18px 34px -24px rgba(11,15,13,.5); }
  .c-n { font-size: 8px; letter-spacing: .1em; color: var(--c); }
  .c-t { margin-top: 9px; font-size: 16px; font-weight: 700; line-height: 1.24; letter-spacing: -0.018em; }
  .c-q { margin-top: 11px; font-size: 14.5px; font-weight: 600; line-height: 1.4; color: var(--ink); }
  .c-s { margin-top: 9px; font-size: 12.5px; line-height: 1.6; color: var(--ink-4); }
  .c-go { display: inline-block; margin-top: 12px; font-size: 12.5px; font-weight: 700; color: var(--c); }
</style>

<script>
  const cv = document.getElementById("fld") as HTMLCanvasElement;
  const tip = document.getElementById("tip") as HTMLElement;
  const ctx = cv.getContext("2d")!;
  const pts = (window as any).__PTS as { k: string; t: string; y: number; v: string; r: boolean; d: number[] }[];
  const cs = getComputedStyle(document.documentElement);
  const hue = [1, 2, 3, 4].map((n) => cs.getPropertyValue(`--a${n}`).trim() || "#009051");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let w = 0, h = 0, focus = -1;
  const nodes = pts.map((p) => ({ ...p, x: 0, y: 0, vx: 0, vy: 0, seed: Math.random() * 7 }));

  function fit() {
    const r = cv.getBoundingClientRect();
    const d = Math.min(devicePixelRatio || 1, 2);
    w = r.width; h = r.height;
    cv.width = w * d; cv.height = h * d;
    ctx.setTransform(d, 0, 0, d, 0, 0);
    place();
  }
  // Four anchors; a paper sits at the mean of the anchors it belongs to.
  const anchors = () => [
    { x: w * 0.24, y: h * 0.28 }, { x: w * 0.76, y: h * 0.28 },
    { x: w * 0.24, y: h * 0.74 }, { x: w * 0.76, y: h * 0.74 },
  ];
  const LABEL = ["EFFICIENCY", "NEUROSYMBOLIC", "RELIABILITY", "AGENTS"];
  function place() {
    const A = anchors();
    for (const n of nodes) {
      const ax = n.d.reduce((s, i) => s + A[i].x, 0) / n.d.length;
      const ay = n.d.reduce((s, i) => s + A[i].y, 0) / n.d.length;
      // A golden-angle spiral keeps a cluster tight and evenly filled.
      const idx = Math.floor(n.seed * 997) % 40;
      const rad = (n.d.length > 1 ? 16 : 12) * Math.sqrt(idx + 1) * (h / 460);
      const th = idx * 2.39996 + n.seed;
      n.x = ax + Math.cos(th) * rad; n.y = ay + Math.sin(th) * rad * 0.82;
    }
  }
  fit();
  new ResizeObserver(fit).observe(cv);

  let t = 0;
  function draw(ts: number) {
    t = ts;
    ctx.clearRect(0, 0, w, h);
    const A = anchors();

    // the four hubs, named
    ctx.textAlign = "center";
    A.forEach((a, i) => {
      const on = focus < 0 || focus === i;
      ctx.fillStyle = `${hue[i]}${on ? "18" : "08"}`;
      ctx.beginPath(); ctx.arc(a.x, a.y, Math.min(w, h) * 0.19, 0, 7); ctx.fill();
      ctx.fillStyle = `${hue[i]}${on ? "cc" : "44"}`;
      ctx.font = '700 9px ui-monospace, monospace';
      ctx.fillText(LABEL[i], a.x, a.y - Math.min(w, h) * 0.19 - 9);
    });

    // links between papers that share a direction, drawn faintly
    ctx.lineWidth = 1;
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      if (a.d.length < 2) continue;
      for (const di of a.d) {
        const on = focus < 0 || focus === di;
        ctx.strokeStyle = `${hue[di]}${on ? "38" : "10"}`;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(A[di].x, A[di].y); ctx.stroke();
      }
    }
    for (const n of nodes) {
      const on = focus < 0 || n.d.includes(focus);
      const drift = still ? 0 : Math.sin(t * 0.0006 + n.seed * 3) * 3;
      const x = n.x, y = n.y + drift;
      const c = hue[n.d.includes(focus) ? focus : n.d[0]];
      ctx.fillStyle = `${c}${on ? (n.r ? "ee" : "66") : "12"}`;
      ctx.beginPath(); ctx.arc(x, y, n.r ? 5.4 : 3.6, 0, 7); ctx.fill();
      if (n.d.length > 1 && on) {
        ctx.strokeStyle = `${hue[n.d[1]]}cc`; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.arc(x, y, 7.6, 0, 7); ctx.stroke();
      }
      (n as any)._sy = y;
    }
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);

  cv.addEventListener("mousemove", (ev) => {
    const r = cv.getBoundingClientRect();
    const mx = ev.clientX - r.left, my = ev.clientY - r.top;
    const hit = nodes.find((n) => Math.hypot(n.x - mx, ((n as any)._sy ?? n.y) - my) < 10);
    if (!hit) { tip.hidden = true; return; }
    tip.innerHTML = `<b>${hit.t}</b><span>${hit.v} · ${hit.y}${hit.d.length > 1 ? " · TWO AVENUES" : ""}</span>`;
    tip.style.left = `${Math.min(mx + 14, r.width - 320)}px`;
    tip.style.top = `${Math.max(8, my - 20)}px`;
    tip.hidden = false;
  });
  cv.addEventListener("mouseleave", () => { tip.hidden = true; });

  const cards = [...document.querySelectorAll<HTMLElement>(".c")];
  const set = (i: number) => {
    focus = i;
    document.querySelectorAll(".lg").forEach((l, j) => l.classList.toggle("on", j === i));
    cards.forEach((c, j) => c.classList.toggle("hot", j === i));
  };
  document.querySelectorAll<HTMLElement>(".lg").forEach((l, i) => {
    l.addEventListener("mouseenter", () => set(i));
    l.addEventListener("mouseleave", () => set(-1));
    l.addEventListener("click", () => set(focus === i ? -1 : i));
  });
  cards.forEach((c, i) => {
    c.addEventListener("mouseenter", () => set(i));
    c.addEventListener("mouseleave", () => set(-1));
  });
</script>
